---
import flatpickr from "flatpickr";
import "flatpickr/dist/flatpickr.min.css";

interface Props {
  checkIn: string;
  checkOut: string;
}

const { checkIn, checkOut } = Astro.props;
---

<div class="flex gap-2">
    <input id="check-in" type="text" placeholder="Check-in" value={checkIn} class="input input-bordered" />
    <input id="check-out" type="text" placeholder="Check-out" value={checkOut} class="input input-bordered" />
</div>

<script type="module">
  import flatpickr from "flatpickr";

  flatpickr("#check-in", {
    minDate: "today",
    onChange: function(selectedDates, dateStr) {
      document.dispatchEvent(new CustomEvent("dateChange", { detail: { checkIn: dateStr } }));
    }
  });

  flatpickr("#check-out", {
    minDate: "today",
    onChange: function(selectedDates, dateStr) {
      document.dispatchEvent(new CustomEvent("dateChange", { detail: { checkOut: dateStr } }));
    }
  });
</script>
