---
import { SITE_CONFIG } from "../../config/constantsConfig";
---

<dialog id="cookie_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box w-full max-w-2xl h-[90vh] md:max-h-screen overflow-y-auto rounded-xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-xl">Cookie Policy & Terms</h3>
            <form method="dialog">
                <button class="btn btn-sm btn-ghost text-xl leading-none">✕</button>
            </form>
        </div>

        <p class="text-sm"><strong>Last Updated:</strong> {SITE_CONFIG.LAST_UPDATED}</p>

        <div class="space-y-4 text-sm mt-4">
            <p>
                Our website uses cookies to ensure proper site functionality and enhance your browsing experience.
            </p>

            <h4 class="font-semibold">Types of Cookies:</h4>
            <ul class="list-disc list-inside">
                <li><strong>Necessary/Technical Cookies:</strong> Required for the website to work correctly (e.g., session management).</li>
                <li><strong>Analytics Cookies:</strong> Help us understand how visitors interact with the site (e.g., Google Analytics). These are anonymous and do not personally identify you.</li>
            </ul>

            <p>
                <strong>Cookie Retention Period:</strong> Your cookie consent is stored for up to {SITE_CONFIG.COOKIE_RETENTION_MONTH} months. After this period, consent will expire, and you will be prompted again.
            </p>

            <p>
                <strong>Managing & Withdrawing Consent:</strong> You can manage your cookie preferences at any time by clicking the “Update Preferences” button in this modal or in the footer.
                Disabling necessary cookies may affect website functionality.
            </p>

            <p>
                By clicking “Accept all”, you consent to the use of analytics cookies. You can always change your preferences with the button below.
            </p>

            <div class="mt-4">
                <button
                        class="bg-[#30363c] text-white px-8 py-3 rounded-lg font-medium hover:bg-[#24292e] transition disabled:bg-gray-400 disabled:cursor-not-allowed disabled:hover:bg-gray-400"
                        id="cookie_preferences_btn"
                        onclick="cookie_modal.close()"
                >
                    Update Preferences
                </button>
            </div>
        </div>
    </div>

    <form method="dialog" class="modal-backdrop">
        <button>Close</button>
    </form>
</dialog>