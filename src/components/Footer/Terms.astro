---
import { SITE_CONFIG } from "../../config/constantsConfig";
---
<dialog id="terms_modal" class="modal">
    <div class="modal-box w-full max-w-2xl max-h-screen overflow-y-auto">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        <h3 class="font-bold text-xl mb-4">Website Terms and Conditions of Use</h3>
        <p class="text-sm"><strong>Last Updated:</strong> October 2025</p>

        <div class="space-y-4 text-sm mt-4">

            <p class="font-bold">1. Introduction and Acceptance of Terms</p>
            <!--<p><strong>1.1. The Website Operator:</strong> domrentals.com (the "Website" or "Site"), is owned and operated by Ion Claudiu Alexandru ("We," "Us," "Our," or the "Site Owner"), P.IVA (VAT ID) **[YOUR VAT NUMBER]**.</p>-->
            <p><strong>1.1. The Website Operator:</strong> domrentals.com (the "Website" or "Site"), is owned and operated by Ion Claudiu Alexandru ("We," "Us," "Our," or the "Site Owner"), VAT ID {SITE_CONFIG.fiscalCode}.</p>
