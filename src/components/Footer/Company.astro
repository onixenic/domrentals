---
import { SITE_CONFIG } from "../../config/constantsConfig";
---

<dialog id="company_data_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box w-full max-w-2xl h-[90vh] md:max-h-screen overflow-y-auto rounded-xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-xl">Legal Details</h3>
            <form method="dialog">
                <button class="btn btn-sm btn-ghost text-xl leading-none">✕</button>
            </form>
        </div>

        <p class="text-sm"><strong>Last Updated:</strong> {SITE_CONFIG.LAST_UPDATED}</p>

        <div class="space-y-3 text-sm mt-4">
            <p><strong>Site Owner:</strong> Ion Claudiu Alexandru</p>
            <p><strong>Registered Office:</strong> {SITE_CONFIG.LEGAL_ADDRESS}</p>
            <p><strong>VAT / Tax ID:</strong> {SITE_CONFIG.FISCAL_CODE}</p>
            <p><strong>Contact Email:</strong> {SITE_CONFIG.CONTACT_EMAIL}</p>
        </div>

        <p class="mt-6 text-xs text-gray-500">
            This information is provided in accordance with Italian law regarding corporate transparency and identification (e.g., Legislative Decree no. 70/2003).
        </p>
    </div>

    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>