---
import ContactUsPriceComponent from "./ContactUsPriceComponent.astro";
import CheckInCheckOut from "./CheckInCheckOut.astro";

interface Props {
  propertyId: string;
  price: number;
  currency: string;
  checkIn: string;
  checkOut: string;
  email: string;
  phoneNumber: string;
  whatsAppNumber: string;
  guests: number;
  extraPerGuest?: number;
  guestCostBasis?: string;
}

const {
  propertyId,
  price,
  currency,
  checkIn,
  checkOut,
  email,
  phoneNumber,
  whatsAppNumber,
  guests,
  extraPerGuest,
  guestCostBasis
} = Astro.props;

let extraChargeNotice = "";

if (guestCostBasis === "perStay" && extraPerGuest) {
  extraChargeNotice = `* An extra charge of ${extraPerGuest}${currency} will be added per person per stay`;
}
---

<div
        class="card bg-base-100 shadow-xl border border-base-300"
        client:load
        data-price={price}
        data-extra-per-guest={extraPerGuest}
        data-currency={currency}
        data-guest-cost-basis={guestCostBasis}
>
    <script type="text/javascript">
      const card = document.currentScript.parentElement;
      const base = Number(card.dataset.price);
      const extra = Number(card.dataset.extraPerGuest);
      const currency = card.dataset.currency;
      const guestCostBasis = card.dataset.guestCostBasis;

      function updatePrice(event) {
        const selectedGuests = Math.max(0, Number(event.target.value) - 1);
        const priceText = document.getElementById("price-text");

        if (guestCostBasis === "perNight") {
          priceText.innerText = base + selectedGuests * extra + " " + currency;
        } else {
          priceText.innerText = base + " " + currency;
        }
      }
    </script>

    <div class="card-body">
        <!-- Price Header -->
        <div class="flex flex-col">
            <div class="flex items-baseline gap-1">
        <span id="price-text" class="text-3xl font-bold">
          {price}{currency}
        </span>
                <span class="text-base text-gray-500">/ night*</span>
            </div>

          {extraChargeNotice && (
                  <p class="text-xs text-gray-600 mt-1">{extraChargeNotice}</p>
          )}
        </div>

      {guestCostBasis === "perNight" && (
        <!-- Guest Selector -->
              <div class="divider my-1"></div>
              <div class="flex justify-between text-sm items-center">
                  <label for="guests" class="font-semibold">Guests</label>
                  <select
                          id="guests"
                          class="text-gray-600 border rounded p-1 w-2/3 text-left"
                          onChange="updatePrice(event)"
                  >
                    {Array.from({length: guests}, (_, i) => (
                            <option value={i + 1}>{i + 1}</option>
                    ))}
                  </select>
              </div>
      )}

        <!-- Check-in/out Info -->
        <div class="divider my-1"></div>

        <!-- Check-in/out Info -->
        <CheckInCheckOut checkIn={checkIn} checkOut={checkOut}/>

        <div class="divider my-1"></div>
        <h3 class="text-xl font-semibold mb-1">Contact your host</h3>
        <ContactUsPriceComponent
                propertyId={propertyId}
                email={email}
                phoneNumber={phoneNumber}
                whatsAppNumber={whatsAppNumber}
        />

        <!-- Price confirmation notice -->
        <p class="text-xs text-gray-500 my-1">*Price must be confirmed by the host</p>
    </div>
</div>
