---
const { title, roomDetails } = Astro.props;
---

<!-- basic info -->
<div class="col-span-6">
    <div class="text-gray-600 text-xs sm:text-base leading-relaxed space-y-2">

        <!-- rooms -->
        {roomDetails.map((room) => (
          <div class="flex items-center gap-2 w-full">

              <!-- Room Name -->
              <span class="font-medium">{room.roomName}:</span>

              <!-- Guests -->
              <div class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                       class="text-gray-500">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/>
                      <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                  </svg>
                  <span>{room.guests} {room.guests === 1 ? "guest" : "guests"}</span>
              </div>

              <span class="sm:inline text-gray-400">·</span>

              <!-- Beds -->
              <div class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-door"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 12v.01" /><path d="M3 21h18" /><path d="M6 21v-16a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v16" /></svg>
                  <span>{room.beds} {room.beds === 1 ? "bed" : "beds"}</span>
              </div>

              <span class="sm:inline text-gray-400">·</span>

              <!-- Bathrooms -->
              <div class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                       class="text-gray-500">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M4 12h16a1 1 0 0 1 1 1v3a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4v-3a1 1 0 0 1 1 -1z"/>
                      <path d="M6 12v-7a2 2 0 0 1 2 -2h3v2.25"/>
                  </svg>
                  <span>{room.bathrooms} {room.bathrooms === 1 ? "bathroom" : "bathrooms"}</span>
              </div>

          </div>
        ))}

    </div>
</div>
