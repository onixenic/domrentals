---
import ContactUsPriceComponent from "./ContactUsPriceComponent.astro";
import CheckInCheckOut from "./CheckInCheckOut.astro";

// --- Utility to format default dates ---
function formatDate(date: Date) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, "0");
    const d = String(date.getDate()).padStart(2, "0");
    return `${y}-${m}-${d}`;
}

const today = new Date();
const tomorrow = new Date();
tomorrow.setDate(today.getDate() + 1);

const checkInDate = formatDate(today);
const checkOutDate = formatDate(tomorrow);

interface PricePeriod {
    from: string;
    to: string;
    price: number;
}

interface RoomPricing {
    price: number;
    pricePeriods: PricePeriod[];
    extraPerGuest: number;
    guestCostBasis: string; // 'perStay' | 'perNight'
}

interface RoomDetail {
    roomName: string;
    guests: number;
    beds: number;
    bathrooms: number;
}

interface Props {
    propertyId: string;
    roomPricing: Record<string, RoomPricing>;
    roomDetails: RoomDetail[];
    currency: string;
    checkIn: string;
    checkOut: string;
    email: string;
    phoneNumber: string;
    whatsAppNumber: string;
}

const {
    propertyId,
    roomPricing,
    roomDetails,
    currency,
    checkIn,
    checkOut,
    email,
    phoneNumber,
    whatsAppNumber
} = Astro.props;

const roomPricingJson = JSON.stringify(roomPricing);
const roomDetailsJson = JSON.stringify(roomDetails);
---

<div
  class="card bg-base-100 shadow-xl border border-base-300"
  client:load
  data-room-pricing={roomPricingJson}
  data-room-details={roomDetailsJson}
  data-currency={currency}
  data-initial-checkin={checkInDate}
  data-initial-checkout={checkOutDate}
>
    <div class="card-body">
        <div class="flex items-baseline gap-1">
            <span id="price-text" class="text-3xl font-bold">{currency}</span>
            <span class="text-base text-gray-500">/ stay*</span>
        </div>

        <div class="divider my-2"></div>

        <div class="space-y-3">

            <!-- Dates -->
            <div class="flex justify-between text-sm items-center">
                <label for="checkIn-input" class="font-semibold">Check-in</label>
                <input
                  type="date"
                  id="checkIn-input"
                  value={checkInDate}
                  class="text-gray-600 border rounded p-1 w-2/3 text-right"
                  onchange="updateCheckInAndPrice()"
                  min={checkInDate}
                />
            </div>

            <div class="flex justify-between text-sm items-center">
                <label for="checkOut-input" class="font-semibold">Check-out</label>
                <input
                  type="date"
                  id="checkOut-input"
                  value={checkOutDate}
                  class="text-gray-600 border rounded p-1 w-2/3 text-right"
                  onchange="updatePrice()"
                />
            </div>

            <div class="divider my-2"></div>

            <!-- Room Selector -->
            <div class="flex justify-between text-sm items-center">
                <label for="roomSelect" class="font-semibold">Room</label>
                <select
                  id="roomSelect"
                  class="text-gray-600 border rounded p-1 w-2/3 text-left"
                  onchange="updateGuestsAndPrice()"
                ></select>
            </div>

            <!-- Guest Selector -->
            <div class="flex justify-between text-sm items-center">
                <label for="guestsSelect" class="font-semibold">Guests</label>
                <select
                  id="guestsSelect"
                  class="text-gray-600 border rounded p-1 w-2/3 text-left"
                  onchange="updatePrice()"
                ></select>
            </div>
        </div>

        <div class="divider my-2"></div>

        <CheckInCheckOut checkIn={checkIn} checkOut={checkOut} />

        <div class="divider my-2"></div>

        <h3 class="text-xl font-semibold mb-1">Contact your host</h3>
        <ContactUsPriceComponent
          propertyId={propertyId}
          email={email}
          phoneNumber={phoneNumber}
          whatsAppNumber={whatsAppNumber}
        />

        <p class="text-xs text-gray-500 my-1">*Price and availability must be confirmed by the host</p>
    </div>

    <script type="text/javascript">
        const card = document.currentScript.parentElement;
        const roomPricing = JSON.parse(card.dataset.roomPricing);
        const roomDetails = JSON.parse(card.dataset.roomDetails);
        const currency = card.dataset.currency;
        const initialCheckIn = card.dataset.initialCheckin;
        const initialCheckOut = card.dataset.initialCheckout;

        const roomSelect = card.querySelector("#roomSelect");
        const guestsSelect = card.querySelector("#guestsSelect");
        const checkInInput = card.querySelector("#checkIn-input");
        const checkOutInput = card.querySelector("#checkOut-input");
        const priceText = card.querySelector("#price-text");

        const MS_PER_DAY = 1000 * 60 * 60 * 24;

        // Populate room select
        Object.keys(roomPricing).forEach((roomName) => {
            const opt = document.createElement("option");
            opt.value = roomName;
            opt.textContent = roomName;
            roomSelect.appendChild(opt);
        });

        // Populate guest options for a room
        function populateGuestsForRoom(roomName) {
            guestsSelect.innerHTML = "";
            const details = roomDetails.find((r) => r.roomName === roomName);
            if (!details) return;
            for (let i = 1; i <= details.guests; i++) {
                const opt = document.createElement("option");
                opt.value = i;
                opt.textContent = i;
                guestsSelect.appendChild(opt);
            }
        }

        // Calculate daily price from periods
        function getDailyPrice(date, periods, basePrice) {
            for (const p of periods) {
                const from = new Date(p.from);
                const to = new Date(p.to);
                if (date >= from && date <= to) return p.price;
            }
            return basePrice;
        }

        // Calculate total price with guest extras
        function calculateTotalPrice(roomName, checkInStr, checkOutStr, guestCount) {
            const room = roomPricing[roomName];
            if (!room || !checkInStr || !checkOutStr) return 0;

            const checkIn = new Date(checkInStr);
            const checkOut = new Date(checkOutStr);
            if (checkOut <= checkIn) return 0;

            const nights = Math.round((checkOut - checkIn) / MS_PER_DAY);
            let total = 0;
            for (let i = 0; i < nights; i++) {
                const day = new Date(checkIn);
                day.setDate(checkIn.getDate() + i);
                total += getDailyPrice(day, room.pricePeriods, room.price);
            }

            // Extra guest cost
            const extraGuests = Math.max(0, guestCount - 1);
            if (extraGuests > 0) {
                const extraCost =
                  room.guestCostBasis === "perNight"
                    ? extraGuests * room.extraPerGuest * nights
                    : extraGuests * room.extraPerGuest;
                total += extraCost;
            }

            return total;
        }

        // Format date to YYYY-MM-DD
        function formatDateString(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, "0");
            const d = String(date.getDate()).padStart(2, "0");
            return `${y}-${m}-${d}`;
        }

        window.updateCheckInAndPrice = function () {
            const checkInDate = new Date(checkInInput.value);
            const checkOutDate = new Date(checkOutInput.value);

            // If check-in is on or after check-out, set check-out to check-in + 1 day
            if (checkInDate >= checkOutDate) {
                const newCheckOut = new Date(checkInDate);
                newCheckOut.setDate(newCheckOut.getDate() + 1);
                checkOutInput.value = formatDateString(newCheckOut);
            }

            // Update minimum check-out date
            checkOutInput.min = formatDateString(new Date(checkInDate.getTime() + MS_PER_DAY));

            updatePrice();
        };

        window.updateGuestsAndPrice = function () {
            populateGuestsForRoom(roomSelect.value);
            updatePrice();
        };

        window.updatePrice = function () {
            const roomName = roomSelect.value;
            const guests = Number(guestsSelect.value);
            const checkIn = checkInInput.value;
            const checkOut = checkOutInput.value;

            if (!roomName || !checkIn || !checkOut || !guests) {
                priceText.textContent = currency;
                return;
            }

            const total = calculateTotalPrice(roomName, checkIn, checkOut, guests);
            priceText.textContent = total.toFixed(2) + " " + currency;
        };

        // Initialize defaults
        const firstRoom = Object.keys(roomPricing)[0];
        populateGuestsForRoom(firstRoom);
        roomSelect.value = firstRoom;

        const total = calculateTotalPrice(firstRoom, initialCheckIn, initialCheckOut, 1);
        priceText.textContent = total.toFixed(2) + " " + currency;
    </script>
</div>