---
// --- Start Date Formatting Utility ---

import ContactUsPriceComponent from "./ContactUsPriceComponent.astro";
function formatDate(date) {
  const year = date.getFullYear();
  // getMonth() is 0-indexed, so we add 1.
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

const today = new Date();
const tomorrow = new Date();
// setDate() handles month/year rollovers automatically
tomorrow.setDate(today.getDate() + 1);

// Use the formatted dates as the default values
const checkInDate = formatDate(today);
const checkOutDate = formatDate(tomorrow);
const checkOutMinDateDefault = checkOutDate;

// --- End Date Formatting Utility ---


interface PricePeriod {
  from: string;
  to: string;
  price: number;
}

interface Props {
  propertyId: string;
  price: number;
  pricePeriods: PricePeriod[];
  currency: string;
  checkIn: string;
  checkOut: string;
  email: string;
  phoneNumber: string;
  whatsAppNumber: string;
}

const {
  propertyId,
  price,
  pricePeriods,
  currency,
  checkIn,
  checkOut,
  email,
  phoneNumber,
  whatsAppNumber
} = Astro.props;


// Pass data as JSON to the client
const pricePeriodsJson = JSON.stringify(pricePeriods);
---
<div
        class="card bg-base-100 shadow-xl border border-base-300"
        client:load
        data-price={price}
        data-currency={currency}
        data-price-periods={pricePeriodsJson}
        data-initial-checkin={checkInDate} data-initial-checkout={checkOutDate}>

    <div class="card-body">
        <div class="flex items-baseline gap-1">
            <span id="price-text" class="text-3xl font-bold">{currency}</span>
            <span class="text-base text-gray-500">/ stay*</span>
        </div>

        <div class="divider my-1"></div>

        <div class="space-y-3">
            <div class="flex justify-between text-sm items-center">
                <label for="checkIn-input" class="font-semibold">Check-in</label>
                <input type="date" id="checkIn-input" value={checkInDate}
                       class="text-gray-600 border rounded p-1 w-2/3 text-right" onchange="updatePrice()"
                       min={checkInDate}/>
            </div>
            <div class="flex justify-between text-sm items-center">
                <label for="checkOut-input" class="font-semibold">Check-out</label>
                <input type="date" id="checkOut-input" value={checkOutDate}
                       class="text-gray-600 border rounded p-1 w-2/3 text-right" onchange="updatePrice()"
                       min={checkOutMinDateDefault}/>
            </div>
            <div class="divider my-1"></div>
            <div class="space-y-3">
                <div class="flex justify-between text-sm items-center">
                    <span class="font-semibold">Check-in</span>
                    <span class="text-gray-600">{checkIn}</span>
                </div>
                <div class="flex justify-between text-sm items-center">
                    <span class="font-semibold">Check-out</span>
                    <span class="text-gray-600">{checkOut}</span>
                </div>
            </div>
        </div>

        <div class="divider my-1"></div>
        <h3 class="text-xl font-semibold mb-1">Contact your host</h3>
        <ContactUsPriceComponent propertyId={propertyId} email={email} phoneNumber={phoneNumber}
                                 whatsAppNumber={whatsAppNumber}/>

        <!-- Price confirmation notice -->
        <p class="text-xs text-gray-500 my-1">*Price and availability must be confirmed by the host</p>
    </div>

    <script type="text/javascript">
      const card = document.currentScript.parentElement;
      const basePrice = Number(card.dataset.price);
      const currency = card.dataset.currency;
      const pricePeriods = JSON.parse(card.dataset.pricePeriods);

      // READ INITIAL DATES FROM DATA ATTRIBUTES
      const initialCheckIn = card.dataset.initialCheckin;
      const initialCheckOut = card.dataset.initialCheckout;

      const checkInInput = card.querySelector("#checkIn-input");
      const checkOutInput = card.querySelector("#checkOut-input");
      const priceText = card.querySelector("#price-text");

      const MS_PER_DAY = 1000 * 60 * 60 * 24;

      function getDailyPrice(date) {
        for (const period of pricePeriods) {
          const fromDate = new Date(period.from);
          const toDate = new Date(period.to);

          if (date >= fromDate && date <= toDate) return period.price;
        }
        return basePrice;
      }

      function calculateTotalPrice(checkInStr, checkOutStr) {
        // NOTE: This check remains, but it's not the primary display control
        if (!checkInStr || !checkOutStr) return basePrice;

        const checkIn = new Date(checkInStr);
        const checkOut = new Date(checkOutStr);

        if (isNaN(checkIn.getTime()) || isNaN(checkOut.getTime()) || checkOut <= checkIn) {
          return basePrice;
        }

        const nights = Math.round((checkOut - checkIn) / MS_PER_DAY);
        let total = 0;
        for (let i = 0; i < nights; i++) {
          const day = new Date(checkIn);
          day.setDate(checkIn.getDate() + i);
          total += getDailyPrice(day);
        }
        return total;
      }

      window.updatePrice = function () {
        const checkInValue = checkInInput.value;
        const checkOutValue = checkOutInput.value;

        // 💡 NEW LOGIC: If checkOutValue is missing, show nothing.
        if (!checkInValue || !checkOutValue) {
          priceText.textContent = `${currency}`; // Or set to an empty string: priceText.textContent = '';
          // If you want to show a message like "Select dates", use: priceText.textContent = 'Select Dates';
          return;
        }

        const total = calculateTotalPrice(checkInValue, checkOutValue);

        // Show the total, using toFixed(2) is usually good practice for currency
        priceText.textContent = total.toFixed(2) + " " + currency;
      }

      // 💡 INITIAL PRICE CALCULATION LOGIC (Using guaranteed dates)
      // We must also apply the check here to ensure if initialCheckOut is empty, no price is shown.
      if (initialCheckIn && initialCheckOut) {
        const total = calculateTotalPrice(initialCheckIn, initialCheckOut);
        priceText.textContent = total.toFixed(2) + " " + currency;
      } else {
        // If the initial checkout date is missing (unlikely with your current utility, but safe)
        priceText.textContent = `${currency}`;
      }

    </script>
</div>