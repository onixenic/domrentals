---
interface Props {
  hostName: string;
  hostImage?: string;
  hostBio: string;
  hostEmail: string;
  hostPhone: string;
  hostLanguages?: string[];
}

const {
  hostName,
  hostImage = "/placeholder.svg",
  hostBio,
  hostEmail,
  hostPhone,
  hostLanguages = ["English"],
} = Astro.props;
---


<div class="card bg-base-100 shadow-xl border border-base-300">
    <div class="card-body p-6 md:p-8">

        <h2 class="card-title text-xl font-bold mb-2 pb-4">Meet Your Host</h2>

        <div class="grid md:grid-cols-3 gap-8 items-start">

          {/* Host Image and Name */}
            <div class="flex flex-col items-center text-center space-y-4">
                <div class="avatar">
                    <div class="w-32 h-32 rounded-full overflow-hidden">
                        <img src={hostImage || "/placeholder.svg"} alt={hostName}
                             class="object-cover w-full h-full"/>
                    </div>
                </div>
                <div>
                    <h3 class="text-lg font-bold">{hostName}</h3>
                    <p class="text-base-content/60 text-sm">Host</p>
                </div>
            </div>

          {/* Host Details */}
            <div class="md:col-span-2 space-y-4">
              {/* Short Description */}
                <p class="text-base-content/80 leading-relaxed">{hostBio}</p>

              {/* Languages */}
                <div>
                    <h4 class="font-semibold text-sm text-base-content/70 mb-1">Languages</h4>
                    <p class="text-base-content/80">{"English"}</p>
                </div>

              {/* Contact Info */}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <h4 class="font-semibold text-sm text-base-content/70 mb-1">Email</h4>
                        <a href={`mailto:${hostEmail}`}
                           class="text hover:underline">{"host@example.com"}</a>
                    </div>
                    <div>
                        <h4 class="font-semibold text-sm text-base-content/70 mb-1">Phone</h4>
                        <a href={`tel:${hostPhone}`} class="text hover:underline">{"+123 456 7890"}</a>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>