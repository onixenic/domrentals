---
interface Props {
  hostName: string;
  hostImage?: string;
  hostBio: string;
  hostEmail: string;
  hostPhone: string;
  hostLanguages: string[];
}

const {
  hostName,
  hostImage = "/placeholder.svg",
  hostBio,
  hostEmail,
  hostPhone,
  hostWhatsapp,
  hostLanguages,
} = Astro.props;
---


<div class="card bg-white shadow-xl border border-base-300">
    <div class="card-body p-6 md:p-8">

        <h2 class="card-title text-xl font-bold mb-2 pb-4">Meet Your Host</h2>

        <div class="grid md:grid-cols-3 gap-8 items-start">

          {/* Host Image and Name */}
            <div class="flex flex-col items-center text-center space-y-4">
                <div class="avatar">
                    <div class="w-32 h-32 rounded-full overflow-hidden">
                        <img src={hostImage || "/placeholder.svg"} alt={hostName}
                             class="object-cover w-full h-full"/>
                    </div>
                </div>
                <div>
                    <h3 class="text-lg font-bold">{hostName}</h3>
                    <p class="text-base-content/60 text-sm">Host</p>
                </div>
            </div>

          {/* Host Details */}
            <div class="md:col-span-2 space-y-4">
              {/* Short Description */}
                <p class="text-base-content/80 leading-relaxed">{hostBio}</p>

              {/* Languages */}
                <div>
                    <h4 class="font-semibold text-sm text-base-content/70 mb-1">Languages</h4>
                    <p class="text-base-content/80">{hostLanguages.join(", ")}</p>
                </div>

              {/* Contact Info */}
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <h4 class="font-semibold text-sm text-base-content/70 mb-1">Email</h4>
                        <a href={`mailto:${hostEmail}`}
                           class="text hover:underline">{hostEmail}</a>
                    </div>
                    <div>
                        <h4 class="font-semibold text-sm text-base-content/70 mb-1">Phone</h4>
                        <a href={`tel:${hostPhone}`} class="text hover:underline">{hostPhone}</a>
                    </div>
                    <div class="flex items-center h-full">
                        <a
                          href={`https://wa.me/${hostWhatsapp}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-500 text-white rounded-full text-sm font-medium hover:bg-green-600 transition-colors"
                        >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              fill="currentColor"
                              viewBox="0 0 24 24"
                              class="w-4 h-4"
                            >
                                <path d="M20.52 3.48A11.77 11.77 0 0 0 12 0a11.77 11.77 0 0 0-8.52 3.48A11.77 11.77 0 0 0 0 12a11.65 11.65 0 0 0 1.55 5.84L0 24l6.31-1.63A11.85 11.85 0 0 0 12 24a11.77 11.77 0 0 0 8.52-3.48A11.77 11.77 0 0 0 24 12a11.77 11.77 0 0 0-3.48-8.52zM12 22.05a10.12 10.12 0 0 1-5.17-1.41l-.37-.22-3.74.97 1-3.64-.24-.37A10.07 10.07 0 0 1 1.95 12 10.12 10.12 0 0 1 12 1.95 10.07 10.07 0 0 1 22.05 12 10.12 10.12 0 0 1 12 22.05zm5.61-7.57c-.31-.16-1.84-.91-2.12-1.02s-.49-.16-.7.16-.8 1.02-.98 1.23-.36.24-.67.08a8.27 8.27 0 0 1-2.44-1.5 9.18 9.18 0 0 1-1.7-2.12c-.18-.31 0-.48.13-.64s.31-.36.46-.55a2.16 2.16 0 0 0 .31-.52.57.57 0 0 0 0-.54c-.08-.16-.7-1.7-.96-2.33s-.51-.54-.7-.55H7.9a1.34 1.34 0 0 0-.96.45 4.03 4.03 0 0 0-1.26 3c0 1.76 1.28 3.46 1.46 3.7s2.5 3.9 6.05 5.33a13.4 13.4 0 0 0 1.33.49 3.21 3.21 0 0 0 1.47.09c.45-.07 1.84-.75 2.1-1.47s.26-1.34.18-1.47-.28-.22-.59-.38z" />
                            </svg>
                            Whatsapp
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>