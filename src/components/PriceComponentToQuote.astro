---
import ContactUsPriceComponent from "./ContactUsPriceComponent.astro";
interface Props {
  propertyId: string;
  checkIn: string;
  checkOut: string;
  email: string;
  phoneNumber: string;
  whatsAppNumber: string;
}

const {
  propertyId,
  checkIn,
  checkOut,
  email,
  phoneNumber,
  whatsAppNumber,
} = Astro.props;
---


<div class="card bg-base-100 shadow-xl border border-base-300">
    <div class="card-body">

        <!-- Check-in/out Info -->
        <div class="space-y-3">
            <div class="flex justify-between text-sm">
                <span class="font-semibold">Check-in</span>
                <span class="text-gray-600">{checkIn}</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="font-semibold">Check-out</span>
                <span class="text-gray-600">{checkOut}</span>
            </div>
        </div>

        <div class="divider my-1"></div>
        <h3 class="text-xl font-semibold mb-1">Contact host for a price</h3>
        <ContactUsPriceComponent propertyId={propertyId} email={email} phoneNumber={phoneNumber}
                                 whatsAppNumber={whatsAppNumber}/>
    </div>
</div>