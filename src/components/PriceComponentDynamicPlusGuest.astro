---
// --- Start Date Formatting Utility ---

import ContactUsPriceComponent from "./ContactUsPriceComponent.astro";
function formatDate(date) {
  const year = date.getFullYear();
  // getMonth() is 0-indexed, so we add 1.
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
}

const today = new Date();
const tomorrow = new Date();
// setDate() handles month/year rollovers automatically
tomorrow.setDate(today.getDate() + 1);

// Use the formatted dates as the default values
const checkInDate = formatDate(today);
const checkOutDate = formatDate(tomorrow);
const checkOutMinDateDefault = checkOutDate;

// --- End Date Formatting Utility ---


interface PricePeriod {
  from: string;
  to: string;
  price: number;
}

interface Props {
  propertyId: string;
  price: number;
  pricePeriods: PricePeriod[];
  currency: string;
  checkIn: string;
  checkOut: string;
  priceCardEmail: string;
  priceCardPhone: string;
  priceCardWhatsApp: string;
  guests: number;
  extraPerGuest: number;
  guestCostBasis: string;
}

const {
  propertyId,
  price,
  pricePeriods,
  currency,
  checkIn,
  checkOut,
  priceCardEmail,
  priceCardPhone,
  priceCardWhatsApp,
  guests,
  extraPerGuest,
  guestCostBasis
} = Astro.props;

const pricePeriodsJson = JSON.stringify(pricePeriods);
---
<div
        class="card bg-base-100 shadow-xl border border-base-300"
        client:load
        data-price={price}
        data-currency={currency}
        data-price-periods={pricePeriodsJson}
        data-initial-checkin={checkInDate}
        data-initial-checkout={checkOutDate}
        data-extra-per-guest={extraPerGuest}
        data-max-guests={guests}
        data-guest-cost-basis={guestCostBasis}
>

    <div class="card-body">
        <div class="flex items-baseline gap-1 mb-4">
            <span id="price-text" class="text-3xl font-bold">{currency}</span>
            <span class="text-base text-gray-500">/ stay</span>
        </div>


        <div class="space-y-3">
            <div class="flex justify-between text-sm items-center">
                <label for="checkIn-input" class="font-semibold">Check-in</label>
                <input type="date" id="checkIn-input" value={checkInDate}
                       class="text-gray-600 border rounded p-1 w-2/3 text-right"
                       onchange="updateMinCheckoutDate(event); updatePrice()" min={checkInDate}/>
            </div>
            <div class="flex justify-between text-sm items-center">
                <label for="checkOut-input" class="font-semibold">Check-out</label>
                <input type="date" id="checkOut-input" value={checkOutDate}
                       class="text-gray-600 border rounded p-1 w-2/3 text-right" onchange="updatePrice()"
                       min={checkOutMinDateDefault}/>
            </div>
        </div>

        <div class="divider my-1"></div>

        <div class="flex justify-between text-sm items-center">
            <label class="font-semibold" for="guests-input">Guests</label>
            <select id="guests-input" class="text-gray-600 border rounded p-1 w-2/3 text-left" onchange="updatePrice()">
              {
                Array.from({length: guests}, (_, i) => (
                        <option value={i + 1}>{i + 1}</option>
                ))
              }
            </select>
        </div>

        <div class="divider my-1"></div>

        <div class="space-y-3">
            <div class="flex justify-between text-sm items-center">
                <span class="font-semibold">Check-in</span>
                <span class="text-gray-600 w-2/3 text-right">{checkIn}</span>
            </div>
            <div class="flex justify-between text-sm items-center">
                <span class="font-semibold">Check-out</span>
                <span class="text-gray-600 w-2/3 text-right">{checkOut}</span>
            </div>
        </div>

        <div class="divider my-1"></div>
        <ContactUsPriceComponent propertyId={propertyId} priceCardEmail={priceCardEmail} priceCardPhone={priceCardPhone}
                                 priceCardWhatsApp={priceCardWhatsApp}/>
    </div>

    <script type="text/javascript">
      const card = document.currentScript.parentElement;
      const basePrice = Number(card.dataset.price);
      const currency = card.dataset.currency;
      const pricePeriods = JSON.parse(card.dataset.pricePeriods);
      const extraPerGuest = Number(card.dataset.extraPerGuest);
      const guestCostBasis = card.dataset.guestCostBasis;

      const initialCheckIn = card.dataset.initialCheckin;
      const initialCheckOut = card.dataset.initialCheckout;

      const checkInInput = card.querySelector("#checkIn-input");
      const checkOutInput = card.querySelector("#checkOut-input");
      const guestsInput = card.querySelector("#guests-input"); // 💡 GET GUEST INPUT
      const priceText = card.querySelector("#price-text");

      const MS_PER_DAY = 1000 * 60 * 60 * 24;

      function getDailyPrice(date) {
        for (const period of pricePeriods) {
          const fromDate = new Date(period.from);
          const toDate = new Date(period.to);

          if (date >= fromDate && date <= toDate) return period.price;
        }
        return basePrice;
      }

      function calculateTotalPrice(checkInStr, checkOutStr) {
        if (!checkInStr || !checkOutStr) return basePrice;

        const checkIn = new Date(checkInStr);
        const checkOut = new Date(checkOutStr);

        if (isNaN(checkIn.getTime()) || isNaN(checkOut.getTime()) || checkOut <= checkIn) {
          return basePrice;
        }

        const nights = Math.round((checkOut - checkIn) / MS_PER_DAY);
        let total = 0;
        for (let i = 0; i < nights; i++) {
          const day = new Date(checkIn);
          day.setDate(checkIn.getDate() + i);
          total += getDailyPrice(day);
        }
        return {total, nights};
      }

      window.updateMinCheckoutDate = function (event) {
        const newCheckInDateStr = event.target.value;
        if (!newCheckInDateStr) {
          checkOutInput.min = card.dataset.initialCheckout;
          return;
        }

        const newCheckInDate = new Date(newCheckInDateStr);
        const minCheckOutDate = new Date(newCheckInDate);
        minCheckOutDate.setDate(newCheckInDate.getDate() + 1);

        const year = minCheckOutDate.getFullYear();
        const month = String(minCheckOutDate.getMonth() + 1).padStart(2, '0');
        const day = String(minCheckOutDate.getDate()).padStart(2, '0');
        const minDateStr = `${year}-${month}-${day}`;

        checkOutInput.min = minDateStr;

        if (checkOutInput.value && checkOutInput.value < minDateStr) {
          checkOutInput.value = '';
        }
      }

      window.updatePrice = function () {
        const checkInValue = checkInInput.value;
        const checkOutValue = checkOutInput.value;
        const selectedGuests = Number(guestsInput.value);

        if (!checkInValue || !checkOutValue) {
          priceText.textContent = `${currency}`;
          return;
        }

        const {total: datesTotal, nights} = calculateTotalPrice(checkInValue, checkOutValue);

        const extraGuests = Math.max(0, selectedGuests - 1);

        let totalGuestSurcharge = 0;

        if (extraGuests > 0) {
          const guestSurchargePerExtraGuest = extraGuests * extraPerGuest;

          if (guestCostBasis === 'perNight') {
            // Apply surcharge for every extra guest, every night
            totalGuestSurcharge = guestSurchargePerExtraGuest * nights;
          } else if (guestCostBasis === 'perStay') {
            // Apply surcharge for every extra guest, only once for the whole stay
            totalGuestSurcharge = guestSurchargePerExtraGuest;
          }
        }

        const finalTotal = datesTotal + totalGuestSurcharge;


        priceText.textContent = finalTotal.toFixed(2) + " " + currency;
      }

      if (initialCheckIn && initialCheckOut) {

        const initialGuests = 1;

        const {total: datesTotal, nights} = calculateTotalPrice(initialCheckIn, initialCheckOut);

        const extraGuests = Math.max(0, initialGuests - 1);
        const guestSurchargePerNight = extraGuests * extraPerGuest;
        const totalGuestSurcharge = guestSurchargePerNight * nights;

        const finalTotal = datesTotal + totalGuestSurcharge;

        priceText.textContent = finalTotal.toFixed(2) + " " + currency;
      } else {
        priceText.textContent = `${currency}`;
      }
    </script>
</div>