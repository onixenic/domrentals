---
import ContactUsPriceComponent from "./ContactUsPriceComponent.astro";
interface Props {
  price: string | number;
  currency: string;
  checkIn: string;
  checkOut: string;
  priceCardEmail: string;
  priceCardPhone: string;
  priceCardWhatsApp: string;
}

const {
  price,
  currency,
  checkIn,
  checkOut,
  priceCardEmail,
  priceCardPhone,
  priceCardWhatsApp,
} = Astro.props;
---


<div class="card bg-base-100 shadow-xl border border-base-300">
    <div class="card-body">
        <!-- Price Header -->
        <div class="flex items-baseline gap-1 mb-4">
            <span class="text-3xl font-bold">{price}{currency}</span>
            <span class="text-base text-gray-500">/ night</span>
        </div>

        <div class="divider my-1"></div>

        <!-- Check-in/out Info -->
        <div class="space-y-3">
            <div class="flex justify-between text-sm">
                <span class="font-semibold">Check-in</span>
                <span class="text-gray-600">{checkIn}</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="font-semibold">Check-out</span>
                <span class="text-gray-600">{checkOut}</span>
            </div>
        </div>

        <div class="divider my-1"></div>
        <ContactUsPriceComponent priceCardEmail={priceCardEmail} priceCardPhone={priceCardPhone} priceCardWhatsApp={priceCardWhatsApp}/>

    </div>
</div>