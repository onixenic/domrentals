---
interface Props {
  price: string | number;
  currency: string;
  checkIn: string;
  checkOut: string;
  priceCardEmail: string;
  priceCardPhone: string;
  priceCardWhatsApp: string;
}

const {
  price,
  currency,
  checkIn,
  checkOut,
  priceCardEmail,
  priceCardPhone,
  priceCardWhatsApp,
} = Astro.props;
---


<div class="card bg-base-100 shadow-xl border border-base-300">
    <div class="card-body">
        <!-- Price Header -->
        <div class="flex items-baseline gap-1 mb-4">
            <span class="text-3xl font-bold">{price}{currency}</span>
            <span class="text-base text-gray-500">/ night</span>
        </div>

        <div class="divider my-1"></div>

        <!-- Check-in/out Info -->
        <div class="space-y-3">
            <div class="flex justify-between text-sm">
                <span class="font-semibold">Check-in</span>
                <span class="text-gray-600">{checkIn}</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="font-semibold">Check-out</span>
                <span class="text-gray-600">{checkOut}</span>
            </div>
        </div>

        <div class="divider my-1"></div>

        <!-- Contact Section -->
        <h3 class="text-xl font-semibold mb-1">Contact us</h3>

        <div class="space-y-3">
            <!-- Email -->
            <a
                    href="mailto:example@example.com"
                    class="flex items-center gap-3 text-blue-600 hover:underline transition-colors"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/>
                    <path d="M3 7l9 6l9 -6"/>
                </svg>
                <span class="text-sm">{priceCardEmail}</span>
            </a>

            <!-- Phone -->
            <a
                    href="tel:+1234567890"
                    class="flex items-center gap-3 text-blue-600 hover:underline transition-colors"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/>
                </svg>
                <span class="text-sm">{priceCardPhone}</span>
            </a>

            <!-- WhatsApp -->
            <a
                    href={`https://wa.me/${priceCardWhatsApp}`}
                    target="_blank"
                    class="flex items-center gap-3 text-green-600 hover:underline transition-colors"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/>
                    <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/>
                </svg>
                <span class="text-sm">WhatsApp</span>
            </a>
        </div>
    </div>
</div>