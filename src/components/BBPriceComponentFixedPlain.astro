---
import ContactUsPriceComponent from "./ContactUsPriceComponent.astro";
import CheckInCheckOut from "./CheckInCheckOut.astro";
interface Props {
  propertyId: string;
  roomPricing: Record<string, {
    price: number;
    pricePeriods: { from: string; to: string; price: number }[];
    extraPerGuest: number;
    guestCostBasis: string;
  }>;
  currency: string;
  checkIn: string;
  checkOut: string;
  email: string;
  phoneNumber: string;
  whatsAppNumber: string;
}

const {
  propertyId,
  roomPricing,
  currency,
  checkIn,
  checkOut,
  email,
  phoneNumber,
  whatsAppNumber,
} = Astro.props;

const roomNames = Object.keys(roomPricing);
---

<div class="card bg-base-100 shadow-xl border border-base-300">
    <div class="card-body">

        <!-- Price Header -->
        <div id="priceContainer" class="flex items-baseline gap-1">
            <span id="priceValue" class="text-3xl font-bold">
              {roomPricing[roomNames[0]].price}{currency}
            </span>
            <span class="text-base text-gray-500">/ night*</span>
        </div>

        <div class="divider my-1"></div>

        <!-- Room Selector -->
        <div class="flex justify-between text-sm items-center">
            <label for="roomSelect" class="font-semibold">Room</label>
            <select
              id="roomSelect"
              class="text-gray-600 border rounded p-1 w-2/3 text-left"
            >
                {roomNames.map((room) => (
                  <option value={room}>{room}</option>
                ))}
            </select>
        </div>

        <div class="divider my-1"></div>

        <!-- Check-in/out Info -->
        <CheckInCheckOut checkIn={checkIn} checkOut={checkOut}/>

        <div class="divider my-1"></div>
        <h3 class="text-xl font-semibold mb-1">Contact your host</h3>
        <ContactUsPriceComponent propertyId={propertyId} email={email} phoneNumber={phoneNumber}
                                 whatsAppNumber={whatsAppNumber}/>
        <!-- Price confirmation notice -->
        <p class="text-xs text-gray-500 my-1">*Price must be confirmed by the host</p>
    </div>
</div>

<!-- Script to update price dynamically -->
<script is:inline set:html={`
  (function() {
    const roomPricing = ${JSON.stringify(roomPricing)};
    const currency = "${currency}";
    const roomSelect = document.getElementById("roomSelect");
    const priceValue = document.getElementById("priceValue");

    if (roomSelect && priceValue) {
      roomSelect.addEventListener("change", () => {
        const selectedRoom = roomSelect.value;
        const basePrice = roomPricing[selectedRoom]?.price ?? 0;
        priceValue.textContent = basePrice + currency;
      });
    }
  })();
`} />
