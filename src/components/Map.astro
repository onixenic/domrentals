---
interface Props {
  mapEmbed: string;
  showDirections?: boolean;
  carDirectionsDescription?: string;
  publicTransportDirectionsDescription?: string;
}

const {
  mapEmbed,
  showDirections = false,
  carDirectionsDescription = "",
  publicTransportDirectionsDescription = "",
} = Astro.props;
---


<!-- Map Section -->
<h2 class="text-2xl font-semibold">How to reach us</h2>
<div class="rounded-2xl overflow-hidden shadow-lg border border-gray-200">
    <iframe
            src={mapEmbed}
            class="w-full h-100"
            allow="geolocation; fullscreen; accelerometer; magnetometer; autoplay; clipboard-write"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
</div>

{ showDirections &&

  <!-- Directions -->
<div class="space-y-6">


    <div>
        <h3 class="flex items-center gap-2 text-md font-semibold">
            <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class="w-5 h-5 flex-shrink-0 align-middle"
                    fill="currentColor"
            >
                <path d="M20.418,2.975A3.008,3.008,0,0,0,17.6,1H6.4A3.008,3.008,0,0,0,3.582,2.975L1.438,8.869A23.785,23.785,0,0,0,0,17.031V19H2v4H8V19h8v4h6V19h2V17.031a23.785,23.785,0,0,0-1.438-8.162ZM5.461,3.658A1,1,0,0,1,6.4,3H17.6a1,1,0,0,1,.939.658l2.144,5.9c.173.477.317.962.456,1.447H2.861c.139-.485.283-.97.456-1.447ZM6,21H4V19H6Zm14,0H18V19h2ZM2,17a21.9,21.9,0,0,1,.382-4H4v1a1,1,0,0,0,1,1H5a1,1,0,0,0,1-1V13H18v1a1,1,0,0,0,1,1h0a1,1,0,0,0,1-1V13h1.618A21.9,21.9,0,0,1,22,17Z"/>
            </svg>
            By Car
        </h3>
        <p class="text-gray-600 mt-1 leading-relaxed" set:html={carDirectionsDescription}>
        </p>
    </div>

    <div>
        <h3 class="flex items-center gap-2 text-md font-semibold">
            <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    class="w-5 h-5 flex-shrink-0 align-middle"
                    fill="currentColor"
            >
                <path d="M22,10V4.229a2.987,2.987,0,0,0-1.821-2.76c-3.673-1.9-12.695-1.893-16.358,0A2.986,2.986,0,0,0,2,4.229V10H0v3a2,2,0,0,0,2,2v7H4v2H9V22h6v2h5V22h2V15a2,2,0,0,0,2-2V10ZM4,13V7H20v6Zm.6-9.688A19.013,19.013,0,0,1,12,2a19.018,19.018,0,0,1,7.4,1.311.99.99,0,0,1,.6.918V5H15V4H9V5H4V4.229A.989.989,0,0,1,4.6,3.312ZM4,20V15H6v1a1,1,0,0,0,2,0V15h8v1a1,1,0,0,0,2,0V15h2v5Z"/>
            </svg>
            By Public Transport
        </h3>
        <p class="text-gray-600 mt-1 leading-relaxed" set:html={publicTransportDirectionsDescription}>
        </p>
    </div>
</div>

  }