---
interface Props {
  propertyId: string;
  email: string;
  phoneNumber: string;
  whatsAppNumber: string;
}

const { propertyId, email, phoneNumber, whatsAppNumber } = Astro.props;

import { logEvent } from "../config/firebaseConfig";
---

<div class="space-y-3" client:load>
    <!-- Email Contact -->
    <a
            id="preview-email"
            href={`mailto:${email}`}
            class="flex items-center gap-3 text-black hover:underline transition-colors"
            data-property-id={propertyId}
            data-email={email}
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="icon icon-tabler icons-tabler-outline icon-tabler-mail">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/>
            <path d="M3 7l9 6l9 -6"/>
        </svg>
        <span class="preview-email-value text-sm">{email}</span>
    </a>

    <!-- Phone Contact -->
    <a
            id="preview-phone"
            href={`tel:${phoneNumber}`}
            class="flex items-center gap-3 text-black hover:underline transition-colors"
            data-property-id={propertyId}
            data-phone={phoneNumber}
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
             class="h-5 w-5">
            <path d="M22.17,1.82l-1.05-.91c-1.21-1.21-3.17-1.21-4.38,0-.03,.03-1.88,2.44-1.88,2.44-1.14,1.2-1.14,3.09,0,4.28l1.16,1.46c-1.46,3.31-3.73,5.59-6.93,6.95l-1.46-1.17c-1.19-1.15-3.09-1.15-4.28,0,0,0-2.41,1.85-2.44,1.88-1.21,1.21-1.21,3.17-.05,4.33l1,1.15c1.15,1.15,2.7,1.78,4.38,1.78,7.64,0,17.76-10.13,17.76-17.76,0-1.67-.63-3.23-1.83-4.42ZM6.24,22c-1.14,0-2.19-.42-2.91-1.15l-1-1.15c-.41-.41-.43-1.08-.04-1.51,0,0,2.39-1.84,2.42-1.87,.41-.41,1.13-.41,1.55,0,.03,.03,2.04,1.64,2.04,1.64,.28,.22,.65,.28,.98,.15,4.14-1.58,7.11-4.54,8.82-8.81,.13-.33,.08-.71-.15-1,0,0-1.61-2.02-1.63-2.04-.43-.43-.43-1.12,0-1.55,.03-.03,1.87-2.42,1.87-2.42,.43-.39,1.1-.38,1.56,.08l1.05,.91c.77,.77,1.2,1.82,1.2,2.96,0,6.96-9.77,15.76-15.76,15.76Z"/>
        </svg>
        <span class="preview-phone-value text-sm">{phoneNumber}</span>
    </a>

    <!-- WhatsApp Contact -->
    <a
            id="preview-whatsapp-link"
            href={`https://wa.me/${whatsAppNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-green-600 hover:underline transition-colors"
            data-property-id={propertyId}
            data-whatsapp={whatsAppNumber}
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/>
            <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/>
        </svg>
        <span class="text-sm">WhatsApp</span>
    </a>
</div>

<script>
  import { logEvent } from "../config/firebaseConfig";

  // Email contact
  document.getElementById("preview-email")?.addEventListener("click", async () => {
    const emailLink = document.getElementById("preview-email");
    const email = emailLink?.dataset.email;
    const propertyId = emailLink?.dataset.propertyId;

    try {
      await logEvent("contact_via_email", {
        method: "email",
        recipient: email,
        propertyId: propertyId,
      });
    } catch (error) {
      console.error("Failed to log email contact event:", error);
    }
  });

  // Phone contact
  document.getElementById("preview-phone")?.addEventListener("click", async () => {
    const phoneLink = document.getElementById("preview-phone");
    const phone = phoneLink?.dataset.phone;
    const propertyId = phoneLink?.dataset.propertyId;

    try {
      await logEvent("contact_via_phone", {
        method: "phone",
        recipient: phone,
        propertyId: propertyId,
      });
    } catch (error) {
      console.error("Failed to log phone contact event:", error);
    }
  });

  // WhatsApp contact
  document.getElementById("preview-whatsapp-link")?.addEventListener("click", async (e) => {

    const whatsappLink = document.getElementById("preview-whatsapp-link");
    const whatsapp = whatsappLink?.dataset.whatsapp;
    const propertyId = whatsappLink?.dataset.propertyId;

    try {
      await logEvent("contact_via_whatsapp", {
        method: "whatsapp",
        recipient: whatsapp,
        propertyId: propertyId,
      });

    } catch (error) {
      console.error("Failed to log whatsapp contact event:", error);
    }
  });
</script>