---
import ApartmentLayout from "../layouts/Showcase.astro";

import Navbar from "../components/Navbar.astro";
import ApartmentHeader from "../components/ApartmentHeader.astro";
import Gallery from "../components/Gallery.astro";
import Description from "../components/Description.astro";
import Services from "../components/Services.astro";
import PriceComponentFixedPlain from "../components/PriceComponentFixedPlain.astro";
import PriceComponentFixedPlainPlusGuest from "../components/PriceComponentFixedPlainPlusGuest.astro";
import PriceComponentDynamic from "../components/PriceComponentDynamic.astro";
import PriceComponentDynamicPlusGuest from "../components/PriceComponentDynamicPlusGuest.astro";
import Map from "../components/Map.astro";
import Host from "../components/Host.astro";
import Footer from "../components/Footer.astro";

import { apartmentConfig } from '../clients/showcase/showcase';
const {
  propertyId,
  headTitle,
  title,
  location,
  guests,
  bathrooms,
  beds,
  bedrooms,
  imagesMainPage,
  imagesByCategory,
  imagesThumbnail,
  description,
  houseRules,
  apartmentServices,
  price,
  pricePeriods,
  extraPerGuest,
  guestCostBasis,
  currency,
  checkIn,
  checkOut,
  email,
  phoneNumber,
  whatsAppNumber,
  mapEmbed,
  showDirections,
  carDirectionsDescription,
  publicTransportDirectionsDescription,
  hostImage,
  hostName,
  hostBio,
  hostEmail,
  hostPhone,
  hostLanguages,
} = apartmentConfig;
---

<ApartmentLayout headTitle={headTitle}>
    <Navbar slot="navbar"/>
    <ApartmentHeader
            slot="header"
            title={title}
            location={location}
            guests={guests}
            bathrooms={bathrooms}
            beds={beds}
            bedrooms={bedrooms}
            description={description}
    />

    <Gallery slot="gallery" imagesMainPage={imagesMainPage} imagesByCategory={imagesByCategory}
             imagesThumbnail={imagesThumbnail}/>
    <Description slot="description" description={description} houseRules={houseRules}/>
    <Services slot="services" apartmentServices={apartmentServices}/>


    <!--<PriceComponentFixedPlain-->
    <!--        headTitle={headTitle}-->
    <!--        slot="price"-->
    <!--        price={price}-->
    <!--        currency={currency}-->
    <!--        checkIn={checkIn}-->
    <!--        checkOut={checkOut}-->
    <!--        email={email}-->
    <!--        phoneNumber={phoneNumber}-->
    <!--        whatsAppNumber={whatsAppNumber}-->

    <!--/>-->

    <PriceComponentFixedPlainPlusGuest
            slot="price"
            propertyId={propertyId}
            price={price}
            currency={currency}
            checkIn={checkIn}
            checkOut={checkOut}
            email={email}
            phoneNumber={phoneNumber}
            whatsAppNumber={whatsAppNumber}
            guests={guests}
            extraPerGuest={extraPerGuest}
            guestCostBasis={guestCostBasis}
    />

    <!--<PriceComponentDynamic-->
    <!--        slot="price"-->
    <!--        propertyId={propertyId}-->
    <!--        price={price}-->
    <!--        pricePeriods={pricePeriods}-->
    <!--        currency={currency}-->
    <!--        checkIn={checkIn}-->
    <!--        checkOut={checkOut}-->
    <!--        email={email}-->
    <!--        phoneNumber={phoneNumber}-->
    <!--        whatsAppNumber={whatsAppNumber}-->
    <!--/>-->


    <!--<PriceComponentDynamicPlusGuest-->
    <!--        slot="price"-->
    <!--        propertyId={propertyId}-->
    <!--        price={price}-->
    <!--        pricePeriods={pricePeriods}-->
    <!--        currency={currency}-->
    <!--        checkIn={checkIn}-->
    <!--        checkOut={checkOut}-->
    <!--        email={email}-->
    <!--        phoneNumber={phoneNumber}-->
    <!--        whatsAppNumber={whatsAppNumber}-->
    <!--        guests={guests}-->
    <!--        extraPerGuest={extraPerGuest}-->
    <!--        guestCostBasis={guestCostBasis}-->
    <!--/>-->

    <Map slot="map" mapEmbed={mapEmbed} showDirections={showDirections}
         carDirectionsDescription={carDirectionsDescription}
         publicTransportDirectionsDescription={publicTransportDirectionsDescription}/>
    <Host slot="host" hostName={hostName} hostImage={hostImage} hostBio={hostBio} hostEmail={email}
          hostPhone={phoneNumber} hostLanguages={hostLanguages}/>
    <Footer slot="footer"/>


</ApartmentLayout>