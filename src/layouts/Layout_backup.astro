---
import "../assets/app.css";
import { services } from "../config/servicesConfig";

const {
    title = "Marina Escape: accogliente appartamento con piscina ad Agadir",
    location = "Agadir, Marocco",
    guests = 4,
    bedrooms = 1,
    beds = 1,
    bathrooms = 1,
    description = "Situato in posizione ideale nel cuore del porto turistico, questo appartamento si trova a pochi passi da negozi, caffè e ristoranti. La spiaggia si trova a soli 5 minuti a piedi e il centro città a 5 minuti di auto (circa 15 dhs in taxi). Goditi l'accesso a 3 grandi piscine circondate da giardini. Taghazout, una rinomata meta per il surf, dista solo 20 minuti. Zona sicura e vivace.\n" +
      "Sono disponibile se hai bisogno di qualcosa. Buon soggiorno!",
    imagesByCategory = {
        all: [
            "https://picsum.photos/800/600?main",
            "https://picsum.photos/800/600?overview",
            "https://picsum.photos/800/600?main",
            "https://picsum.photos/800/600?main",
            "https://picsum.photos/800/600?main"
        ],
        pool: [
            "https://picsum.photos/800/600?pool1",
            "https://picsum.photos/800/600?pool2",
            "https://picsum.photos/800/600?pool1",
            "https://picsum.photos/800/600?pool2",
            "https://picsum.photos/800/600?pool1",
            "https://picsum.photos/800/600?pool2",
            "https://picsum.photos/800/600?pool1",
            "https://picsum.photos/800/600?pool2"
        ],
        kitchen: [
            "https://picsum.photos/800/600?kitchen1",
            "https://picsum.photos/800/600?kitchen2",
        ],
        room1: [
            "https://picsum.photos/800/600?room1a",
            "https://picsum.photos/800/600?room1b",
        ],
        room3: [
            "https://picsum.photos/800/600?room2a",
            "https://picsum.photos/800/600?room2b",
        ],
        kitchen1: [
            "https://picsum.photos/800/600?kitchen1",
            "https://picsum.photos/800/600?kitchen2",
        ],
        room4: [
            "https://picsum.photos/800/600?room1a",
            "https://picsum.photos/800/600?room1b",
        ],
        room6: [
            "https://picsum.photos/800/600?room2a",
            "https://picsum.photos/800/600?room2b",
        ],
    },
    price = "120€",
    checkIn = "After 2PM",
    checkOut = "Before 11AM",
    priceCardEmail = "test@gmail.com",
    priceCardPhone = "+39 000 000 0000",
    priceCardWhatsApp = "0390000000000",
    apartmentServices = {
        wifi: true,
        ac: false,
        kitchen: true,
        balcony: true,
        swimming_pool: false,
    },
    mapEmbed = "https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d9424.986464587197!2d-9.611422683088698!3d30.421412278194722!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMzDCsDI1JzI3LjIiTiA5wrAzNycwMC4xIlc!5e0!3m2!1sit!2sit!4v1760522582943!5m2!1sit!2sit",
    showDirections = true,
    carDirectionsDescription = `Take the main highway from the city center, exit at <span class="font-medium">Marina Street</span>,then follow the signs to the apartment complex. Free on-site parking is available.`,
    publicTransportDirectionsDescription = `Take <span class="font-medium">bus number 5</span> from the central station towards Marina. Get off at <span class="font-medium">“Marina Escape Stop”</span>. From there, it’s a short 5-minute walk to the apartment.`,
    hostImage = "https://picsum.photos/800/600?main",
    hostName = "Mario",
    hostBio = "Mario",
    hostEmail = "Mario",
    hostPhone = "Mario",
} = Astro.props;
---

<html lang="en" data-theme="light">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap" rel="stylesheet">
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>{title}</title>
</head>
<body>

<div class="navbar bg-base-100 shadow-sm">
    <div class="navbar-start"/>
    <div class="navbar-center">
        <a class="btn btn-ghost text-xl">LOGO</a>
    </div>
    <div class="navbar-end"/>
</div>


<main class="flex-1 mx-auto px-6 py-10 max-w-6xl">
    <div class="grid grid-cols-6 gap-4">
        <!-- Title and basic info -->
        <div class="col-span-6">
            <h1 class="text-2xl font-bold">{title}</h1>
            <div
              class="flex flex-wrap gap-1 text-gray-600 mt-2 items-center text-xs sm:text-base  leading-relaxed"
            >
                <!-- Location -->
                <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                         class="text-gray-500">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/>
                        <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"/>
                    </svg>
                    <span>{location}</span>
                </div>

                <!-- Divider (hidden on mobile to reduce clutter) -->
                <span class="sm:inline text-gray-400">·</span>

                <!-- Guests -->
                <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                         class="text-gray-500">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/>
                        <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                    </svg>
                    <span>{guests} ospiti</span>
                </div>

                <span class="sm:inline text-gray-400">·</span>

                <!-- Bathrooms -->
                <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                         class="text-gray-500">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M4 12h16a1 1 0 0 1 1 1v3a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4v-3a1 1 0 0 1 1 -1z"/>
                        <path d="M6 12v-7a2 2 0 0 1 2 -2h3v2.25"/>
                    </svg>
                    <span>{bathrooms} bagno</span>
                </div>

                <div class="sm:inline text-gray-400 gap-0">·</div>

                <!-- Beds -->
                <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                         class="text-gray-500">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M7 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
                        <path d="M22 17v-3h-20"/>
                        <path d="M2 8v9"/>
                        <path d="M12 14h10v-2a3 3 0 0 0 -3 -3h-7v5z"/>
                    </svg>
                    <span>{beds} letto</span>
                </div>

                <span class="sm:inline text-gray-400">·</span>

                <!-- Bedrooms -->
                <div class="flex items-center gap-1">
                    <span>{bedrooms} camera da letto</span>
                </div>

                <!-- Share button -->
                <button
                  class="btn btn-sm btn-circle btn-ghost sm:ml-auto flex items-center gap-1 text-gray-700 hover:text-primary transition-colors w-full sm:w-auto justify-center border border-gray-200 sm:border-0 py-1 px-2 mt-2 sm:mt-0"
                  onclick="navigator.share ? navigator.share({title: '{title}', text: '{description}', url: window.location.href}) : alert('Sharing not supported')"
                >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-gray-600"
                    >
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M6 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/>
                        <path d="M18 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/>
                        <path d="M18 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/>
                        <path d="M8.7 10.7l6.6 -3.4"/>
                        <path d="M8.7 13.3l6.6 3.4"/>
                    </svg>
                    <span class="block sm:hidden">Share</span>
                </button>
            </div>

        </div>


        <!-- Image gallery -->
        <div class="col-span-6">
            <div class="hidden sm:grid grid-cols-2 gap-2 overflow-hidden rounded-lg">
                <img src={imagesByCategory.all[0]} alt="Main"
                     class="w-full h-98 object-cover hover:shadow-lg hover:brightness-70 cursor-pointer"
                     onclick="openGalleryModal()"/>
                <div class="grid grid-cols-2 gap-2">
                    <div class="space-y-2">
                        <img src={imagesByCategory.all[1]} alt="Small1"
                             class="w-full h-48 object-cover hover:shadow-lg hover:brightness-70 cursor-pointer"
                             onclick="openGalleryModal()"/>
                        <img src={imagesByCategory.all[2]} alt="Small2"
                             class="w-full h-48 object-cover hover:shadow-lg hover:brightness-70 cursor-pointer"
                             onclick="openGalleryModal()"/>
                    </div>
                    <div class="space-y-2">
                        <img src={imagesByCategory.all[3]} alt="Small3"
                             class="w-full h-48 object-cover hover:shadow-lg hover:brightness-70 cursor-pointer"
                             onclick="openGalleryModal()"/>
                        <div class="relative">
                            <img src={imagesByCategory.all[4]} alt="Small4"
                                 class="w-full h-48 object-cover hover:shadow-lg hover:brightness-70 cursor-pointer"
                                 onclick="openGalleryModal()"/>
                            <button
                              class="btn border-1 border-black absolute bottom-3 right-3 flex items-center gap-2 px-4 py-2 text-base sm:px-2 sm:py-1 text-xs"
                              onclick="openGalleryModal()"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                                     stroke-linejoin="round" class="icon icon-tabler icon-tabler-photo-scan">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M15 8h.01"/>
                                    <path d="M6 13l2.644 -2.644a1.21 1.21 0 0 1 1.712 0l3.644 3.644"/>
                                    <path d="M13 13l1.644 -1.644a1.21 1.21 0 0 1 1.712 0l1.644 1.644"/>
                                    <path d="M4 8v-2a2 2 0 0 1 2 -2h2"/>
                                    <path d="M4 16v2a2 2 0 0 0 2 2h2"/>
                                    <path d="M16 4h2a2 2 0 0 1 2 2v2"/>
                                    <path d="M16 20h2a2 2 0 0 0 2 -2v-2"/>
                                </svg>
                                <span>More images</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile carousel -->
            <div class="relative sm:hidden carousel rounded-box">
                {Object.values(imagesByCategory)
                  .flat()
                  .map((img, i) => (
                    <div class="carousel-item w-full relative" key={i}>
                        <img
                          src={img}
                          class="w-full h-80 object-cover cursor-pointer"
                          onclick="openGalleryModal()"/>
                        {/* Counter */}
                        <div class="absolute bottom-3 right-3 bg-black/70 text-white text-sm px-3 py-1 rounded-full">
                            {i + 1} / {Object.values(imagesByCategory).flat().length}
                        </div>
                    </div>
                  ))}
            </div>

        </div>

        <dialog id="gallery_modal" class="modal">
            <div class="modal-box !px-0 lg:!px-6 pt-0 w-full h-full max-w-full max-h-full max-w-none max-h-none rounded-none"
                 id="gallery_modal_box">
                <div class="mx-auto md:px-6 max-w-6xl">
                    <!-- Dynamic Tabs -->

                    <div class="sticky py-6 px-4">
                        <button
                          onclick="closeGalleryModal()"
                          class="btn btn-sm btn-circle btn-ghost"
                          aria-label="Close gallery"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-left">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M5 12l14 0"/>
                                <path d="M5 12l6 6"/>
                                <path d="M5 12l6 -6"/>
                            </svg>
                        </button>

                    </div>
                    <div class="sticky top-0 bg-base-100 z-30 pt-6 pb-20 overflow-x-auto" id="gallery_tabs">
                        <div class="tabs tabs-bordered flex flex-nowrap min-w-max lg:flex-wrap lg:min-w-0 px-6 lg:px-0">
                            {Object.keys(imagesByCategory).filter((category) => category.toLowerCase() !== "all").map((category, index) => (
                              <button
                                type="button"
                                class={`tab relative flex-shrink-0 ${index === 0 ? "tab-active pl-0" : ""}`}
                                data-target={category}
                              >
                                  <div class="flex flex-col items-center gap-1">
                                      <img
                                        src={imagesByCategory[category]?.[0] || "/placeholder.svg"}
                                        alt={`${category}-0`}
                                        class="w-20 h-20 object-cover rounded-sm"
                                      />
                                      <span class="text-xs text-center">
                                    {category.charAt(0).toUpperCase() + category.slice(1)}
                                </span>
                                  </div>
                              </button>
                            ))}
                        </div>
                    </div>

                    <div class="mx-auto max-w-7xl px-0 py-0 lg:px-12 lg:py-12">
                        {Object.entries(imagesByCategory)
                          .map(([key, value]) => [key, value])
                          .filter(([category]) => category.toLowerCase() !== "all")
                          .map(([category, imgs]) => (
                            <section id={category} class="mb-20 flex flex-col gap-8 lg:flex-row lg:gap-12">
                                {/* Left side: sticky title */}
                                <div class="lg:w-1/5 px-6 lg:px-0">
                                    <h2 class="text-2xl font-medium tracking-tight text-foreground lg:sticky lg:top-24">
                                        {category.charAt(0).toUpperCase() + category.slice(1)}
                                    </h2>
                                </div>

                                {/* Right side: images grid */}
                                <div class="flex-1">
                                    <div class="grid grid-cols-2 gap-4 lg:gap-5">
                                        {imgs.map((img, i) => (
                                          <div
                                            class={`
                                                group relative overflow-hidden bg-muted cursor-pointer
                                                ${i % 3 === 0 ? "col-span-2" : "col-span-1"}
                                            `}
                                            data-image={img}
                                          >
                                              <img
                                                src={img || "/placeholder.svg"}
                                                alt={`${category}-${i}`}
                                                class={`
                                                    h-full w-full object-cover transition-transform duration-200
                                                    group-hover:scale-105
                                                    ${i % 3 === 0 ? "aspect-[16/9]" : "aspect-square"}
                                                `}
                                              />
                                              <div class="absolute inset-0 bg-foreground/0 transition-colors duration-300 group-hover:bg-foreground/5"/>
                                          </div>
                                        ))}
                                    </div>
                                </div>
                            </section>
                          ))}
                    </div>
                </div>
            </div>

            <!-- Modal for full-size image -->
            <div
              id="imageModal"
              class="fixed inset-0 hidden items-center justify-center bg-foreground/90 p-4 backdrop-blur-sm"
            >
                <button
                  id="closeModal"
                  class="absolute right-6 top-6 text-background hover:text-background/80 transition-colors"
                  aria-label="Close modal"
                >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="32"
                      height="32"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
                <img
                  id="modalImage"
                  src="/placeholder.svg"
                  alt="Full size"
                  class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain"
                />
            </div>

            <script>
                // expose open/close on window Scroll functionality
                window.openGalleryModal = function () {
                    const d = document.getElementById("gallery_modal");
                    if (d && !d.open) d.showModal();
                    // optionally focus first tab for keyboard users
                    const firstTab = document.querySelector("#gallery_tabs .tab");
                    firstTab?.focus();
                };

                window.closeGalleryModal = function () {
                    const d = document.getElementById("gallery_modal");
                    if (d && d.open) d.close();
                };

                window.scrollToSection = function (id, btnEl) {
                    const container = document.getElementById("gallery_modal_box");
                    const section = document.getElementById(id);
                    if (!section || !container) return;

                    // activate clicked tab (if provided)
                    if (btnEl) {
                        document.querySelectorAll("#gallery_tabs .tab").forEach((t) => t.classList.remove("tab-active"));
                        btnEl.classList.add("tab-active");
                    }

                    if (section.previousElementSibling === null) {
                        container.scrollTo({top: 0, behavior: "smooth"});
                    } else {
                        const sectionTopRelative = section.offsetTop;
                        let offset = 150;
                        container.scrollTo({top: sectionTopRelative - offset, behavior: "smooth"});
                    }
                };

                // Wire tab clicks (delegation) so we don't rely on inline onclick string eval
                (function wireGalleryTabs() {
                    const tabsContainer = document.getElementById("gallery_tabs");
                    if (!tabsContainer) return;
                    tabsContainer.addEventListener("click", function (ev) {
                        const btn = ev.target.closest(".tab");
                        if (!btn) return;
                        const target = btn.getAttribute("data-target");
                        if (!target) return;
                        // call the global function (keeps behavior consistent)
                        window.scrollToSection(target, btn);
                    });
                })();

                // Modal functionality
                const modal = document.getElementById('imageModal');
                const modalImage = document.getElementById('modalImage') as HTMLImageElement;
                const closeButton = document.getElementById('closeModal');
                const imageContainers = document.querySelectorAll('[data-image]');

                // Open modal when clicking on an image
                imageContainers.forEach((container) => {
                    container.addEventListener('click', () => {
                        const imageSrc = container.getAttribute('data-image');
                        if (imageSrc && modal && modalImage) {
                            modalImage.src = imageSrc;
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                        }
                    });
                });

                // Close modal
                const closeModal = () => {
                    if (modal) {
                        modal.classList.add('hidden');
                        modal.classList.remove('flex');
                    }
                };

                closeButton?.addEventListener('click', closeModal);
                modal?.addEventListener('click', (e) => {
                    if (e.target === modal) {
                        closeModal();
                    }
                });

                // Close on escape key
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        closeModal();
                    }
                });
            </script>
        </dialog>


    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-8">
        <!-- Left Column: Description + Services -->
        <div class="lg:col-span-7">
            <!-- Description Section -->
            <section class="mb-12">
                <h2 class="text-2xl font-semibold mb-4">Description</h2>
                <p class="text-gray-700 leading-relaxed whitespace-pre-line mb-4">
                    {description}
                </p>
                <div class="flex justify-end">
                    <button
                      class="btn btn-outline btn-sm"
                      onclick="houseRulesModal.showModal()"
                    >
                        View rules
                    </button>
                </div>
            </section>

            <!-- Services Section -->
            <section>
                <h2 class="text-2xl font-semibold my-8">What our place offers</h2>

                <!-- Services Grid -->
                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    {services
                      .filter((service) => apartmentServices[service.key]).slice(0, 9).map((service) => (
                        <div class="flex items-center gap-3 text-gray-700">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 32 32"
                              aria-hidden="true"
                              class="w-6 h-6 flex-shrink-0"
                              fill="currentColor"
                            >
                                <path d={service.iconPath}/>
                            </svg>
                            <span class="text-sm">{service.name}</span>
                        </div>
                      ))}
                </div>


                { Object.values(apartmentServices).filter(Boolean).length > 9 && (
                  <div class="mt-8 flex justify-end">
                      <button
                        class="btn btn-outline btn-sm"
                        onclick="services_modal.showModal()"
                      >
                          Show all {Object.values(apartmentServices).filter(Boolean).length} amenities
                      </button>
                  </div>
                )}

            </section>
        </div>

        <!-- Right Column: Sticky Price Card -->
        <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-8">
                <div class="card bg-base-100 shadow-xl border border-base-300">
                    <div class="card-body">
                        <!-- Price Header -->
                        <div class="flex items-baseline gap-1 mb-4">
                            <span class="text-3xl font-bold">{price}</span>
                            <span class="text-base text-gray-500">/ night</span>
                        </div>

                        <div class="divider my-1"></div>

                        <!-- Check-in/out Info -->
                        <div class="space-y-3">
                            <div class="flex justify-between text-sm">
                                <span class="font-semibold">Check-in</span>
                                <span class="text-gray-600">{checkIn}</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="font-semibold">Check-out</span>
                                <span class="text-gray-600">{checkOut}</span>
                            </div>
                        </div>

                        <div class="divider my-1"></div>

                        <!-- Contact Section -->
                        <h3 class="text-xl font-semibold mb-1">Contact us</h3>

                        <div class="space-y-3">
                            <!-- Email -->
                            <a
                              href="mailto:example@example.com"
                              class="flex items-center gap-3 text-blue-600 hover:underline transition-colors"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/>
                                    <path d="M3 7l9 6l9 -6"/>
                                </svg>
                                <span class="text-sm">{priceCardEmail}</span>
                            </a>

                            <!-- Phone -->
                            <a
                              href="tel:+1234567890"
                              class="flex items-center gap-3 text-blue-600 hover:underline transition-colors"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/>
                                </svg>
                                <span class="text-sm">{priceCardPhone}</span>
                            </a>

                            <!-- WhatsApp -->
                            <a
                              href={`https://wa.me/${priceCardWhatsApp}`}
                              target="_blank"
                              class="flex items-center gap-3 text-green-600 hover:underline transition-colors"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/>
                                    <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/>
                                </svg>
                                <span class="text-sm">WhatsApp</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- House Rules Modal -->
    <dialog id="houseRulesModal" class="modal">
        <div class="modal-box max-w-2xl">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
            </form>
            <h3 class="text-2xl font-bold mb-6">House Rules</h3>
            <ul class="space-y-3">
                <li class="flex items-start gap-2">
                    <span class="text-primary mt-1">•</span>
                    <span>No smoking inside the apartment.</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-primary mt-1">•</span>
                    <span>No pets allowed.</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-primary mt-1">•</span>
                    <span>Check-in after 3 PM, check-out before 11 AM.</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-primary mt-1">•</span>
                    <span>Parties and events are not allowed.</span>
                </li>
                <li class="flex items-start gap-2">
                    <span class="text-primary mt-1">•</span>
                    <span>Please respect the neighbors and keep noise to a minimum.</span>
                </li>
            </ul>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    <!-- All Services Modal -->
    <dialog id="services_modal" class="modal">
        <div class="modal-box max-w-4xl">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
            </form>
            <h3 class="text-2xl font-bold mb-6">All Amenities</h3>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                {services
                  .filter((service) => apartmentServices[service.key]).map((service) => (
                    <div class="flex items-center gap-3 text-gray-700">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 32 32"
                          aria-hidden="true"
                          class="w-6 h-6 flex-shrink-0"
                          fill="currentColor"
                        >
                            <path d={service.iconPath}/>
                        </svg>
                        <span class="text-sm">{service.name}</span>
                    </div>
                  ))}
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>


    <!-- Map Section -->
    <div class="col-span-6 row-start-5 my-8 space-y-8">
        <h2 class="text-2xl font-semibold">How to reach us</h2>


        <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-200">
            <iframe
              src={mapEmbed}
              class="w-full h-100"
              allow="geolocation; fullscreen; accelerometer; magnetometer; autoplay; clipboard-write"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
        </div>

        { showDirections &&

          <!-- Directions -->
          <div class="space-y-6">
              <div>
                  <h3 class="flex items-center gap-2 text-md font-semibold">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                           class="icon icon-tabler icons-tabler-outline icon-tabler-car">
                          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                          <path d="M7 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
                          <path d="M17 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
                          <path d="M5 17h-2v-6l2 -5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5"/>
                      </svg>
                      By Car
                  </h3>
                  <p class="text-gray-600 mt-1 leading-relaxed" set:html={carDirectionsDescription}>
                  </p>
              </div>

              <div>
                  <h3 class="flex items-center gap-2 text-md font-semibold">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                           class="icon icon-tabler icons-tabler-outline icon-tabler-bus">
                          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                          <path d="M6 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
                          <path d="M18 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/>
                          <path d="M4 17h-2v-11a1 1 0 0 1 1 -1h14a5 7 0 0 1 5 7v5h-2m-4 0h-8"/>
                          <path d="M16 5l1.5 7l4.5 0"/>
                          <path d="M2 10l15 0"/>
                          <path d="M7 5l0 5"/>
                          <path d="M12 5l0 5"/>
                      </svg>
                      By Public Transport
                  </h3>
                  <p class="text-gray-600 mt-1 leading-relaxed" set:html={publicTransportDirectionsDescription}>
                  </p>
              </div>
          </div>

        }

        <div class="col-span-6">
            <div class="card bg-base-100 shadow-xl border border-base-300">
                <div class="card-body p-6 md:p-8">

                    <h2 class="card-title text-xl font-bold mb-2 pb-4">Meet Your Host</h2>

                    <div class="grid md:grid-cols-3 gap-8 items-start">

                        {/* Host Image and Name */}
                        <div class="flex flex-col items-center text-center space-y-4">
                            <div class="avatar">
                                <div class="w-32 h-32 rounded-full overflow-hidden">
                                    <img src={hostImage || "/placeholder.svg"} alt={hostName}
                                         class="object-cover w-full h-full"/>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold">{hostName}</h3>
                                <p class="text-base-content/60 text-sm">Host</p>
                            </div>
                        </div>

                        {/* Host Details */}
                        <div class="md:col-span-2 space-y-4">
                            {/* Short Description */}
                            <p class="text-base-content/80 leading-relaxed">{hostBio}</p>

                            {/* Languages */}
                            <div>
                                <h4 class="font-semibold text-sm text-base-content/70 mb-1">Languages</h4>
                                <p class="text-base-content/80">{"English"}</p>
                            </div>

                            {/* Contact Info */}
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <h4 class="font-semibold text-sm text-base-content/70 mb-1">Email</h4>
                                    <a href={`mailto:${hostEmail}`}
                                       class="text hover:underline">{"host@example.com"}</a>
                                </div>
                                <div>
                                    <h4 class="font-semibold text-sm text-base-content/70 mb-1">Phone</h4>
                                    <a href={`tel:${hostPhone}`} class="text hover:underline">{"+123 456 7890"}</a>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>


    </div>


</main>

<!-- Footer -->
<footer class="footer bg-base-200 text-base-content p-6 text-center">
    <p>© 2025 My Apartments. All rights reserved.</p>
</footer>
</body>
</html>
