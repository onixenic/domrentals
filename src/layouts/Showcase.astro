---
import "../assets/app.css";

import Cookie from "../components/CookieHeader.astro"
import CookieScript from "../components/CookieScript.astro";
// import Translator from "../components/Translator.astro";

const {
  headTitle,
} = Astro.props;
---

<html lang="en" data-theme="light">
<head>

    <Cookie />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap" rel="stylesheet">
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>{headTitle}</title>

</head>
<body>
<slot name="navbar"/>

<main class="flex-1 mx-auto px-6 py-8 max-w-6xl">

    <div id="google_translate_element"></div>
    <div class="grid grid-cols-6 gap-4">
        <slot name="header"/>
        <slot name="gallery"/>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-8">
        <div class="lg:col-span-7">
            <slot name="description"/>
            <slot name="services"/>
        </div>
        <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-8">
                <slot name="price"/>
            </div>
        </div>
    </div>

    <div class="col-span-6 row-start-5 my-8 space-y-8">
        <slot name="map"/>
    </div>

    <div class="col-span-6 row-start-5 my-8 space-y-8">
        <div class="col-span-6">
            <slot name="host"/>

        </div>
    </div>
</main>
<slot name="footer"/>


</body>

<CookieScript />
</html>
