---
import PropertyConfigLayout from "../components/Client/PropertyConfigLayout.jsx";
import Cookie from "../components/CookieHeader.astro";
import CookieScript from "../components/CookieScript.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
---

<html lang="en" data-theme="light">
<head>
    <Cookie/>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Property Config Editor</title>

    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link
            href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap"
            rel="stylesheet"
    />
</head>

<body class="min-h-screen flex flex-col font-[Geist] bg-white text-gray-900">

<Navbar slot="navbar"/>

<main class="flex-1 mx-auto px-6 py-12 max-w-6xl w-full font-[Geist]">
    <PropertyConfigLayout client:load/>
</main>
<Footer/>
<CookieScript/>
</body>