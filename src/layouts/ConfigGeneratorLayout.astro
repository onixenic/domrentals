---
import "../assets/app.css";
import Cookie from "../components/CookieHeader.astro";
import CookieScript from "../components/CookieScript.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { services } from "../config/servicesConfig";
import { currencies } from '../config/currencies';

const mostUsed = ["USD", "EUR", "GBP", "JPY", "AUD", "CAD"];
const sortedCurrencies = [
  ...currencies.filter(c => mostUsed.includes(c.code)),
  ...currencies
    .filter(c => !mostUsed.includes(c.code))
    .sort((a, b) => a.code.localeCompare(b.code))
];

let propertyId = "test";
let propertyPsw = "test";

// const res = await fetch("/api/generatePropertyId", Astro.url);
// if (res.ok) {
//     const data = await res.json();
//     propertyId = data.propertyId;
//     propertyPsw = data.propertyPsw;
// }
---

<html lang="en" data-theme="light">
<head>
    <Cookie/>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Property Config Editor</title>

    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link
            href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap"
            rel="stylesheet"
    />
</head>

<body class="min-h-screen flex flex-col font-[Geist] bg-white text-gray-900">

<Navbar slot="navbar"/>

<main class="flex-1 mx-auto px-6 py-12 max-w-6xl w-full font-[Geist]">
    <form
            id="config-form"
            class="bg-white border border-gray-200 rounded-2xl shadow-sm p-10 space-y-10"
    >
        <h1 class="text-2xl font-bold text-gray-800 border-b pb-2">
            Property Configuration
        </h1>

        <h2 class="text-lg font-semibold text-gray-800 mb-2">Host Data</h2>

        <!-- 🏠 Property Info -->
        <div class="grid md:grid-cols-2 gap-6">

            <!-- Property ID -->
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1" for="propertyId">Property ID</label>
                <input
                        type="text"
                        id="propertyId"
                        name="propertyId"
                        value={propertyId}
                        class="input w-full mt-1"
                        readonly
                />
            </div>

            <!-- Property Password -->
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1" for="propertyPsw">Property Password</label>
                <input
                        type="text"
                        id="propertyPsw"
                        name="propertyPsw"
                        value={propertyPsw}
                        class="input w-full mt-1"
                        readonly
                />
            </div>
        </div>

        <!-- 🏢 Host Info -->
        <div>

            <!-- Host Type: Company or Individual -->
            <div class="flex flex-col md:col-span-2 mb-6">
                <span class="text-sm font-medium text-gray-700 mb-1">Host Type</span>
                <div class="flex gap-4 mt-1">
                    <label class="flex items-center gap-2">
                        <input type="radio" name="hostType" value="company" class="radio" required"/>
                        Company
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="radio" name="hostType" value="individual" class="radio" required"/>
                        Individual
                    </label>
                </div>
            </div>

            <!-- Company Fields -->
            <div id="companyFields" class="grid md:grid-cols-5 gap-6 hidden">
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="companyName">Company Name</label>
                    <input type="text" id="companyName" name="companyName" class="input w-full mt-1"
                           placeholder="Ex. ABC Ltd."/>
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="companyAddress">Legal Address</label>
                    <input type="text" id="companyAddress" name="companyAddress" class="input w-full mt-1"
                           placeholder="Ex. 123 Main Street, Rome, Italy"/>
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="companyVat">VAT Number</label>
                    <input type="text" id="companyVat" name="companyVat" class="input w-full mt-1"
                           placeholder="Ex. IT1234567890"/>
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="companyRep">Legal Representative</label>
                    <input type="text" id="companyRep" name="companyRep" class="input w-full mt-1"
                           placeholder="Ex. Jane Smith"/>
                </div>
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="companyName">Company Name</label>
                    <input type="text" id="hostEmail" name="companyName" class="input w-full mt-1"
                           placeholder="Ex. info@example.com"/>
                </div>
            </div>

            <!-- Individual Fields -->
            <div id="individualFields" class="grid md:grid-cols-5 gap-6 hidden">
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="individualName">Full Name</label>
                    <input type="text" id="individualName" name="individualName" class="input w-full mt-1"
                           placeholder="Ex. John Doe"/>
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="individualAddress">Residential
                        Address</label>
                    <input type="text" id="individualAddress" name="individualAddress" class="input w-full mt-1"
                           placeholder="Ex. 456 Main Street, Rome, Italy"/>
                </div>

                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="individualTaxId">Tax ID</label>
                    <input type="text" id="individualTaxId" name="individualTaxId" class="input w-full mt-1"
                           placeholder="Ex. 12345678901"/>
                </div>
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="companyName">Company Email</label>
                    <input type="text" id="hostEmail" name="companyName" class="input w-full mt-1"
                           placeholder="Ex. info@example.com"/>
                </div>
            </div>
        </div>

        <!-- 🏡 Property Type -->
        <fieldset class="space-y-2">
            <h2 class="text-lg font-semibold text-gray-800">Property Type</h2>
            <div class="flex flex-wrap gap-6 mt-2">
                <label class="flex items-center gap-2">
                    <input type="radio" name="type" value="bb" class="radio"/>
                    <span>B&amp;B</span>
                </label>

                <label class="flex items-center gap-2">
                    <input
                            type="radio"
                            name="type"
                            value="apartment"
                            class="radio"
                            checked
                    />
                    <span>Villa / Apartment</span>
                </label>
            </div>
        </fieldset>

        <!-- 📝 General Info -->
        <div class="grid md:grid-cols-2 gap-6">

            <!-- Title -->
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1" for="title">Title</label>
                <input
                        type="text"
                        id="title"
                        name="title"
                        class="input w-full mt-1"
                        placeholder="Ex. Cozy Seaside Apartment"
                        required
                />
            </div>

            <!-- Location -->
            <div class="flex flex-col md:flex-row md:items-center gap-4">
                <!-- Full Address -->
                <div class="flex-1 flex flex-col">
                    <label class="text-sm font-medium text-gray-700 mb-1" for="location">Location</label>
                    <input
                            type="text"
                            id="location"
                            name="fullAddress"
                            class="input w-full mt-1"
                            placeholder="Ex. Via Antonio Gramsci 1, Bologna, Italy"
                            required
                    />
                </div>

                <!-- Show Directions -->
                <div class="relative flex items-center gap-2 mt-6 md:mt-0">
                    <input
                            type="checkbox"
                            id="showDirections"
                            name="showDirections"
                            value="true"
                            class="w-4 h-4 text-blue-600 border-gray-300 rounded cursor-pointer"
                    />
                    <label
                            for="showDirections"
                            class="text-sm text-gray-700 cursor-pointer relative group"
                    >
                        Show directions
                        <!-- Tooltip -->
                        <span id="tooltip"
                              class="absolute left-0 -top-14 w-64 p-2 text-xs text-white bg-gray-800 rounded shadow-lg opacity-0 pointer-events-none transition-opacity duration-200">
                            We’ll create a section for your guests with instructions on how to reach the apartment by car or public transport.
                        </span>
                    </label>
                </div>
            </div>

            <!-- Email -->
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1" for="email">Email</label>
                <input
                        type="email"
                        id="email"
                        name="email"
                        class="input w-full mt-1"
                        placeholder="Ex. info@example.com"
                        required
                />
            </div>

            <!-- Phone -->
            <div class="flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1" for="phone">Phone Number</label>
                <input
                        type="tel"
                        id="phone"
                        name="phone"
                        class="input w-full mt-1"
                        placeholder="Ex. +39 123 456 7890"
                        required
                />
            </div>

            <!-- Languages -->
            <div class="flex flex-col md:col-span-2">
                <label class="text-sm font-medium text-gray-700 mb-2">Languages Spoken by Host</label>
                <div class="grid md:grid-cols-3 gap-4">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="languages[]" value="English" class="checkbox"/>
                        <span>English</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="languages[]" value="Italian" class="checkbox"/>
                        <span>Italian</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="languages[]" value="Spanish" class="checkbox"/>
                        <span>Spanish</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="languages[]" value="French" class="checkbox"/>
                        <span>French</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="languages[]" value="German" class="checkbox"/>
                        <span>German</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="languages[]" value="other" class="checkbox"
                               id="language-other-checkbox"/>
                        <span>Other</span>
                    </label>
                </div>

                <!-- Optional "Other" input -->
                <input
                        type="text"
                        name="languagesOther"
                        placeholder="Specify other language"
                        class="input mt-2 hidden w-full"
                        id="language-other-input"
                />
            </div>

        </div>

        <!-- 🛏️ B&B Fields -->
        <div id="bb-section" hidden>
            <h2 class="text-lg font-semibold text-gray-800">B&amp;B Details</h2>

            <div class="mt-4 space-y-6">
                <!-- Rooms header with button -->
                <div class="flex items-center gap-4">
                    <span class="text-sm font-medium text-gray-700">Rooms:</span>
                    <span id="bb-rooms" class="font-semibold text-gray-800">0</span>
                    <button
                            type="button"
                            id="add-room-btn"
                            class="bg-gray-200 px-4 py-2 rounded hover:bg-gray-300 transition"
                    >
                        Add Room
                    </button>
                </div>


                <div id="bb-rooms-container" class="space-y-4"></div>

                <div id="bb-room-template" class="border border-gray-200 rounded relative hidden">

                    <div class="grid md:grid-cols-5 gap-4 p-4">
                        <label class="block">
                            <span class="text-sm font-medium text-gray-700">Room Name</span>
                            <input type="text" name="bb_rooms[__INDEX__][name]" class="input mt-1"
                                   placeholder="Ex. Sea View Room"/>
                        </label>

                        <label class="block">
                            <span class="text-sm font-medium text-gray-700">Guests</span>
                            <input type="number" name="bb_rooms[__INDEX__][guests]" class="input mt-1" min="1"/>
                        </label>

                        <label class="block">
                            <span class="text-sm font-medium text-gray-700">Beds</span>
                            <input type="number" name="bb_rooms[__INDEX__][beds]" class="input mt-1" min="1"/>
                        </label>

                        <label class="block">
                            <span class="text-sm font-medium text-gray-700">Bathrooms</span>
                            <input type="number" name="bb_rooms[__INDEX__][bathrooms]" class="input mt-1" min="1"/>
                        </label>

                        <label class="flex items-center gap-2 mt-6 md:mt-5">
                            <input type="checkbox" name="bb_rooms[__INDEX__][privateBathroom]" class="checkbox"/>
                            <span>Private Bathroom</span>
                        </label>
                    </div>
                    <div class="md:col-span-1 p-5 flex md:justify-end md:items-start">
                        <button
                                type="button"
                                class="delete-room-btn bg-red-500 text-white font-bold rounded w-full md:w-10 h-10 flex items-center justify-center"
                        >
                            X
                        </button>
                    </div>
                </div>


                <!-- Breakfast Section (existing) -->
                <fieldset class="block mt-4">
                    <span class="text-sm font-medium text-gray-700">Breakfast</span>

                    <div class="mt-3 space-y-3">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" id="breakfast-included" name="breakFastIncluded" checked/>
                            <span>Included in stay</span>
                        </label>

                        <div id="breakfast-options" class="hidden ml-6 space-y-3">
                            <label class="flex items-center gap-2">
                                <input type="checkbox" id="breakfast-available" name="breakFastAvailable"/>
                                <span>Available as add-on</span>
                            </label>

                            <label id="breakfast-cost-label" class="block hidden">
                                <span class="text-sm font-medium text-gray-700">Breakfast Cost (€)</span>
                                <input type="number" name="breakFastCost" id="breakfast-cost" class="input mt-1"
                                       min="0" step="0.5"/>
                            </label>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>

        <!-- 🏘️ Apartment Fields -->
        <div id="apartment-section">
            <h2 class="text-lg font-semibold text-gray-800">
                Villa / Apartment Details
            </h2>

            <div class="mt-4 grid md:grid-cols-4 gap-6">
                <label class="block">
                    <span class="text-sm font-medium text-gray-700">Guests</span>
                    <input type="number" name="guests" class="input mt-1" min="1"/>
                </label>

                <label class="block">
                    <span class="text-sm font-medium text-gray-700">Bedrooms</span>
                    <input type="number" name="bedrooms" class="input mt-1" min="1"/>
                </label>

                <label class="block">
                    <span class="text-sm font-medium text-gray-700">Beds</span>
                    <input type="number" name="beds" class="input mt-1" min="1"/>
                </label>

                <label class="block">
                    <span class="text-sm font-medium text-gray-700">Bathrooms</span>
                    <input type="number" name="bathrooms" class="input mt-1" min="1"/>
                </label>
            </div>
        </div>

        <!-- 🏷️ Pricing Section -->
        <div class="mt-6">
            <div class="bg-white border border-gray-200 rounded-2xl shadow-md p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-2">Pricing</h2>
                <p class="text-gray-600 text-sm mb-4">
                    Choose how you want to display pricing to guests.
                </p>

                <!-- Pricing options -->
                <div class="space-y-3">
                    <label class="flex items-center gap-2">
                        <input type="radio" name="pricingType" value="contactHost" class="radio" checked/>
                        <span>No price shown, contact host</span>
                    </label>

                    <label class="flex items-center gap-2">
                        <input type="radio" name="pricingType" value="fixedAllYear" class="radio"/>
                        <span>Fixed price all year</span>
                    </label>

                    <label class="flex items-center gap-2">
                        <input type="radio" name="pricingType" value="fixedExtraGuests" class="radio"/>
                        <span>Fixed price, plus extra per guest</span>
                    </label>

                    <!-- Dynamic price options -->
                    <label class="flex items-center gap-2">
                        <input type="radio" name="pricingType" value="dynamicDates" class="radio"/>
                        <span>Price based on dates</span>
                    </label>

                    <label class="flex items-center gap-2">
                        <input type="radio" name="pricingType" value="dynamicDatesExtraGuests" class="radio"/>
                        <span>Price based on dates, plus extra per guest</span>
                    </label>

                    <!-- Description for dynamic pricing -->
                    <p id="dynamic-price-desc" class="text-gray-600 text-sm mt-1 hidden">
                        We will keep in contact with you to update the prices as you want them to be shown.
                    </p>
                </div>

                <!-- B&B Room Tabs -->
                <div id="bb-pricing-tabs" class="mt-6 hidden">
                    <h3 class="text-md font-semibold text-gray-800 mb-3">Set Pricing Per Room</h3>
                    <div id="room-tabs" class="flex gap-2 border-b border-gray-300 mb-4 flex-wrap"></div>
                    <div id="room-pricing-content"></div>
                </div>

                <!-- Apartment/Villa Pricing (single) -->
                <div id="apartment-pricing-content" class="mt-6 hidden"></div>
            </div>
        </div>

        <div class="flex gap-4">
            <div class="flex-1 flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1" for="checkout">Check-out Time</label>
                <input
                        type="time"
                        id="checkout"
                        name="checkout"
                        class="input w-full mt-1"
                        required
                />
            </div>
            <div class="flex-1 flex flex-col">
                <label class="text-sm font-medium text-gray-700 mb-1" for="checkin">Check-in Time</label>
                <input
                        type="time"
                        id="checkin"
                        name="checkin"
                        class="input w-full mt-1"
                        required
                />
            </div>
        </div>


        <div>
            <h2 class="text-lg font-semibold text-gray-800 mb-2">House Rules</h2>
            <textarea
                    name="houseRules"
                    class="input h-32 mt-1 w-full "
                    required
            >No smoking inside the apartment.
No pets allowed.
Check-in after 2 PM, check-out before 11 AM.
Parties and events are not allowed.
Please respect the neighbors and keep noise to a minimum.</textarea>
        </div>

        <div>
            <h2 class="text-lg font-semibold text-gray-800 mb-2">Services (guests can use on their own)</h2>
            <p class="text-gray-600 mb-4">
                Facilities and services accessible to guests for <strong>self-use</strong> during their stay.
            </p>
            <div class="grid md:grid-cols-2 gap-4">
                <!-- Service checkboxes will be injected here -->
              {services.map(service => (
                      <label class="flex items-center gap-2" key={service.key}>
                          <input type="checkbox" name={`services[${service.key}]`} class="checkbox"/>
                          <span>{service.name}</span>
                      </label>
              ))}
            </div>
        </div>

        <div>
            <h2 class="text-lg font-semibold text-gray-800 mb-2">Additional Services</h2>
            <p class="text-gray-600 mb-2">
                Specify any extra facilities or services that guests can use on their own which are not included in the
                list above.
            </p>
            <textarea
                    name="additionalServices"
                    class="input h-24 mt-1 w-full "
                    placeholder="Ex. Hot tub, private gym, barbecue area..."
            ></textarea>
        </div>

        <div class="mt-4">
            <h2 class="text-lg font-semibold text-gray-800 mb-2">Host Description</h2>
            <p class="text-gray-600 mb-2">Please provide a short description about yourself:</p>
            <textarea
                    name="hostDescription"
                    placeholder="Ex. (click to change):  Managed by Daniela, this property is part of a portfolio dedicated to high-standard accommodations and professional service. We prioritize seamless check-in/out and exceptional cleanliness. Rest easy knowing that all utilities, detailed local guides, and 24/7 guest support are handled by an experienced team. We're here to ensure your focus stays purely on your vacation."
                    class="input w-full h-32 mt-1"
            ></textarea>
        </div>

        <!-- Add before the submit button, inside the form -->
        <div class="flex items-start gap-2 border-t pt-6">
            <input
                    type="checkbox"
                    id="privacy-consent"
                    name="privacyConsent"
                    required
                    class="checkbox mt-1"
            />
            <label for="privacy-consent" class="text-sm text-gray-700">
                I have read and accept the
                <a href="#" onclick="privacy_modal.showModal(); return false;"
                   class="text-blue-600 underline">Privacy Policy</a>
                and consent to the processing of my personal data for the purposes
                of creating and managing my property configuration.
                <span class="text-red-500">*</span>
            </label>
        </div>

        <!-- Update the submit button section -->
        <div class="flex justify-end mt-6">
            <button
                    type="button"
                    id="download-btn"
                    class="bg-black text-white px-8 py-3 rounded-lg font-medium hover:bg-gray-800 transition disabled:bg-gray-400 disabled:cursor-not-allowed disabled:hover:bg-gray-400"
                    disabled
            >
                Download Config JSON
            </button>
        </div>
    </form>
</main>

<!-- ✅ JS toggle logic -->
<script>

  document.addEventListener("DOMContentLoaded", () => {
    const privacyConsent = document.getElementById("privacy-consent");
    const downloadBtn = document.getElementById("download-btn");

    // Enable/disable button based on checkbox state
    privacyConsent.addEventListener("change", () => {
      downloadBtn.disabled = !privacyConsent.checked;
    });
  });

  document.getElementById("download-btn").addEventListener("click", () => {
    const form = document.getElementById("config-form");
    const formData = new FormData(form);

    // Determine property type
    const propertyType = formData.get("type");
    const pricingType = formData.get("pricingType");

    // Common fields
    const baseConfig = {};

    const apartmentServices = {};

    for (const [key, value] of formData.entries()) {
      const match = key.match(/^services\[(.+)\]$/);
      if (match) {
        const serviceKey = match[1];
        apartmentServices[serviceKey] = true;
      }
    }


    let json;

    if (propertyType === "apartment") {

      let price = null;
      let pricePeriods = null;
      let extraPerGuest = null;
      let guestCostBasis = null;
      let currency = null;

      if (pricingType === "fixedAllYear" || pricingType === "fixedExtraGuests") {
        price = Number(formData.get("pricing[fixedPrice]")) || null;
        currency = formData.get("pricing[currency]") || null;
      }

      if (pricingType === "fixedExtraGuests" || pricingType === "dynamicDatesExtraGuests") {
        extraPerGuest = Number(formData.get("pricing[extraPerGuest]")) || null;
        guestCostBasis = formData.get("pricing[extraPerGuestType]") || null;
      }

      if (pricingType === "dynamicDates" || pricingType === "dynamicDatesExtraGuests") {
        pricePeriods = []; // To be populated later by host
      }


      json = {
        propertyId: formData.get("propertyId"),
        propertyPsw: formData.get("propertyPsw"),
        hostType: formData.get("hostType"),
        companyName: formData.get("hostType") === "company" ? formData.get("companyName") || null : null,
        companyAddress: formData.get("hostType") === "company" ? formData.get("companyAddress") || null : null,
        companyVat: formData.get("hostType") === "company" ? formData.get("companyVat") || null : null,
        companyRep: formData.get("hostType") === "company" ? formData.get("companyRep") || null : null,
        individualName: formData.get("hostType") === "individual" ? formData.get("individualName") || null : null,
        individualAddress: formData.get("hostType") === "individual" ? formData.get("individualAddress") || null : null,
        individualTaxId: formData.get("hostType") === "individual" ? formData.get("individualTaxId") || null : null,
        hostEmail: formData.get("hostEmail"),
        headTitle: formData.get("title"),
        title: formData.get("title"),
        location: formData.get("fullAddress"),
        guests: Number(formData.get("guests")),
        bedrooms: Number(formData.get("bedrooms")),
        beds: Number(formData.get("beds")),
        bathrooms: Number(formData.get("bathrooms")),
        imagesMainPage: null,
        imagesThumbnail: null,
        imagesByCategory: null,
        description: null,
        houseRules: (formData.get("houseRules") || "").split("\n"),
        price,
        pricePeriods,
        extraPerGuest,
        guestCostBasis,
        currency,
        checkIn: formData.get("checkin") || null,
        checkOut: formData.get("checkout") || null,
        email: formData.get("email") || null,
        phoneNumber: formData.get("phone") || null,
        whatsAppNumber: null,
        apartmentServices,
        additionalServices: formData.get("additionalServices") || null,
        mapEmbed: null,
        showDirections: formData.get("showDirections") === "true" || null,
        carDirectionsDescription: null,
        publicTransportDirectionsDescription: null,
        hostImage: null,
        hostName: null,
        hostBio: formData.get("hostDescription") || null,
        hostLanguages: formData.getAll("languages[]") || null
      };
    } else if (propertyType === "bb") {
      const roomsContainer = document.getElementById("bb-rooms-container");
      const roomDetails = [];
      const roomPricing = {};

      Array.from(roomsContainer.children).forEach((roomDiv) => {
        const roomData = {};
        roomDiv.querySelectorAll("input, select").forEach((input) => {
          const name = input.name.match(/\[([^\]]+)\]$/)?.[1];
          if (!name) return;

          roomData[name] =
            input.type === "checkbox" ? input.checked : input.value;
        });

        roomDetails.push({
          roomName: roomData.name,
          guests: Number(roomData.guests),
          beds: Number(roomData.beds),
          bathrooms: Number(roomData.bathrooms),
          privateBathroom: roomData.privateBathroom || false,
        });

        // Parse room pricing from dynamically generated fields
        let price = null;
        let pricePeriods = null;
        let extraPerGuest = null;
        let guestCostBasis = null;

        if (pricingType === "fixedAllYear" || pricingType === "fixedExtraGuests") {
          const priceInput = document.querySelector(`input[name="pricing[${roomIndex}][fixedPrice]"]`);
          price = priceInput ? Number(priceInput.value) || null : null;
        }

        if (pricingType === "fixedExtraGuests" || pricingType === "dynamicDatesExtraGuests") {
          const extraInput = document.querySelector(`input[name="pricing[${roomIndex}][extraPerGuest]"]`);
          const typeSelect = document.querySelector(`select[name="pricing[${roomIndex}][extraPerGuestType]"]`);
          extraPerGuest = extraInput ? Number(extraInput.value) || null : null;
          guestCostBasis = typeSelect ? typeSelect.value : "perStay";
        }

        if (pricingType === "dynamicDates" || pricingType === "dynamicDatesExtraGuests") {
          pricePeriods = []; // To be populated later
        }

        roomPricing[roomName] = {
          price,
          pricePeriods: pricePeriods || [],
          extraPerGuest: extraPerGuest || 0,
          guestCostBasis: guestCostBasis || "perStay",
        };
      });

      // Get currency from first room or default
      const currencySelect = document.querySelector(`select[name="pricing[0][currency]"]`);
      const currency = currencySelect ? currencySelect.value : null;

      json = {
        propertyId: formData.get("propertyId"),
        propertyPsw: formData.get("propertyPsw"),
        hostType: formData.get("hostType"),
        companyName: formData.get("hostType") === "company" ? formData.get("companyName") || null : null,
        companyAddress: formData.get("hostType") === "company" ? formData.get("companyAddress") || null : null,
        companyVat: formData.get("hostType") === "company" ? formData.get("companyVat") || null : null,
        companyRep: formData.get("hostType") === "company" ? formData.get("companyRep") || null : null,
        individualName: formData.get("hostType") === "individual" ? formData.get("individualName") || null : null,
        individualAddress: formData.get("hostType") === "individual" ? formData.get("individualAddress") || null : null,
        individualTaxId: formData.get("hostType") === "individual" ? formData.get("individualTaxId") || null : null,
        hostEmail: formData.get("hostEmail"),
        headTitle: formData.get("title"),
        title: formData.get("title"),
        location: formData.get("fullAddress"),
        rooms: roomDetails.length,
        breakFastIncluded: formData.get("breakFastIncluded") === "on",
        breakFastAvailable: formData.get("breakFastAvailable") === "on",
        breakFastCost: formData.get("breakFastCost") || null,
        roomDetails,
        imagesMainPage: null,    // Fill with actual paths if needed
        imagesThumbnail: null,
        imagesByCategory: null,
        description: null,
        houseRules: (formData.get("houseRules") || "").split("\n"),
        roomPricing,
        currency,
        checkIn: formData.get("checkin") || null,
        checkOut: formData.get("checkout") || null,
        email: formData.get("email") || null,
        phoneNumber: formData.get("phone") || null,
        whatsAppNumber: null,
        apartmentServices,
        additionalServices: formData.get("additionalServices") || null,
        mapEmbed: null,
        showDirections: formData.get("showDirections") === "true" || null,
        carDirectionsDescription: null,
        publicTransportDirectionsDescription: null,
        hostImage: null,
        hostName: null,
        hostBio: formData.get("hostDescription") || null,
        hostLanguages: formData.getAll("languages[]") || null
      };
    }

    // Download JSON
    const blob = new Blob([JSON.stringify(json, null, 2)], {
      type: "application/json",
    });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${propertyType}-${json.propertyId || "config"}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  document.addEventListener("DOMContentLoaded", () => {
    const breakfastIncluded = document.getElementById("breakfast-included");
    const breakfastOptions = document.getElementById("breakfast-options");
    const breakfastAvailable = document.getElementById("breakfast-available");
    const breakfastCostLabel = document.getElementById("breakfast-cost-label");

    const toggleBreakfastOptions = () => {
      if (breakfastIncluded.checked) {
        // Included in stay → hide available & cost
        breakfastOptions.classList.add("hidden");
        breakfastAvailable.checked = false;
        breakfastCostLabel.classList.add("hidden");
        document.getElementById("breakfast-cost").value = "";
      } else {
        // Not included → show available checkbox
        breakfastOptions.classList.remove("hidden");
        // Show cost only if available is checked
        toggleBreakfastCost();
      }
    };

    const toggleBreakfastCost = () => {
      if (breakfastAvailable.checked) {
        breakfastCostLabel.classList.remove("hidden");
      } else {
        breakfastCostLabel.classList.add("hidden");
        document.getElementById("breakfast-cost").value = "";
      }
    };

    breakfastIncluded.addEventListener("change", toggleBreakfastOptions);
    breakfastAvailable.addEventListener("change", toggleBreakfastCost);

    // Initialize on page load
    toggleBreakfastOptions();
  });


  const otherCheckbox = document.getElementById("language-other-checkbox");
  const otherInput = document.getElementById("language-other-input");

  otherCheckbox.addEventListener("change", () => {
    if (otherCheckbox.checked) {
      otherInput.classList.remove("hidden");
    } else {
      otherInput.classList.add("hidden");
      otherInput.value = "";
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    const pricingRadios = document.querySelectorAll('input[name="pricingType"]');
    const bbPricingTabs = document.getElementById("bb-pricing-tabs");
    const apartmentPricingContent = document.getElementById("apartment-pricing-content");
    const dynamicDesc = document.getElementById("dynamic-price-desc");
    const roomTabsContainer = document.getElementById("room-tabs");
    const roomPricingContent = document.getElementById("room-pricing-content");
    const typeRadios = document.querySelectorAll('input[name="type"]');
    const bbRoomsContainer = document.getElementById("bb-rooms-container");
    const addRoomBtn = document.getElementById("add-room-btn");

    let currentRoomTab = 0;
    let propertyType = "apartment";

    // Track property type
    typeRadios.forEach(radio => {
      if (radio.checked) propertyType = radio.value;
      radio.addEventListener("change", () => {
        propertyType = radio.value;
        updatePricingDisplay();
      });
    });

    // Generate pricing form HTML
    function generatePricingForm(pricingType, roomIndex = null) {
      const prefix = roomIndex !== null ? `room_${roomIndex}_` : "";
      const namePrefix = roomIndex !== null ? `pricing[${roomIndex}]` : "pricing";

      let html = '';

      if (pricingType === "fixedAllYear" || pricingType === "fixedExtraGuests") {
        html += `
                <div class="mt-4">
                    <h4 class="text-md font-semibold text-gray-800 mb-2">Fixed Price</h4>
                    <div class="flex gap-4 items-center">
                        <div class="flex-1">
                            <input
                                type="number"
                                name="${namePrefix}[fixedPrice]"
                                id="${prefix}fixedPrice"
                                class="input mt-1 w-full"
                                placeholder="e.g., 120"
                            />
                        </div>
                        <div class="w-32">
                            <select name="${namePrefix}[currency]" id="${prefix}currency" class="input mt-1 w-full">
                                <option value="EUR">EUR – €</option>
                                <option value="USD">USD – $</option>
                                <option value="GBP">GBP – £</option>
                            </select>
                        </div>
                    </div>
                    <p class="text-gray-600 text-sm mt-2">Price per night by default.</p>
                </div>
            `;
      }

      if (pricingType === "fixedExtraGuests" || pricingType === "dynamicDatesExtraGuests") {
        html += `
                <div class="mt-4">
                    <h4 class="text-md font-semibold text-gray-800 mb-2">Extra Fee per Guest</h4>
                    <p class="text-gray-600 text-sm mb-2">
                        Charge extra guests <strong>per night</strong> or <strong>per stay</strong>.
                    </p>
                    <div class="grid md:grid-cols-2 gap-4 items-end">
                        <label class="block">
                            <span class="text-sm font-medium text-gray-700">Extra per guest (€)</span>
                            <input
                                type="number"
                                name="${namePrefix}[extraPerGuest]"
                                id="${prefix}extraPerGuest"
                                class="input mt-1"
                                placeholder="e.g., 20"
                                min="0"
                                step="0.5"
                            />
                        </label>
                        <label class="block">
                            <span class="text-sm font-medium text-gray-700">Charge Type</span>
                            <select name="${namePrefix}[extraPerGuestType]" id="${prefix}extraPerGuestType" class="input mt-1">
                                <option value="perNight">Per night</option>
                                <option value="perStay">Per stay</option>
                            </select>
                        </label>
                    </div>
                </div>
            `;
      }

      return html;
    }

    // Update B&B room tabs
    function updateRoomTabs() {
      const rooms = bbRoomsContainer.children;
      roomTabsContainer.innerHTML = '';

      Array.from(rooms).forEach((room, index) => {
        const roomNameInput = room.querySelector('input[name*="[name]"]');
        const roomName = roomNameInput?.value || `Room ${index + 1}`;

        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = `px-4 py-2 font-medium rounded-t-lg ${index === currentRoomTab ? 'bg-gray-800 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}`;
        tab.textContent = roomName;
        tab.addEventListener('click', () => {
          currentRoomTab = index;
          updateRoomTabs();
          updateRoomPricingContent();
        });

        roomTabsContainer.appendChild(tab);
      });
    }

    // Update room pricing content
    function updateRoomPricingContent() {
      const selectedPricing = document.querySelector('input[name="pricingType"]:checked')?.value;
      if (selectedPricing === "contactHost" || selectedPricing === "dynamicDates") {
        roomPricingContent.innerHTML = '';
        return;
      }

      roomPricingContent.innerHTML = generatePricingForm(selectedPricing, currentRoomTab);
    }

    // Update apartment pricing content
    function updateApartmentPricingContent() {
      const selectedPricing = document.querySelector('input[name="pricingType"]:checked')?.value;
      if (selectedPricing === "contactHost" || selectedPricing === "dynamicDates") {
        apartmentPricingContent.innerHTML = '';
        return;
      }

      apartmentPricingContent.innerHTML = generatePricingForm(selectedPricing);
    }

    // Main update function
    function updatePricingDisplay() {
      const selectedPricing = document.querySelector('input[name="pricingType"]:checked')?.value;

      // Show/hide dynamic description
      if (selectedPricing === "dynamicDates" || selectedPricing === "dynamicDatesExtraGuests") {
        dynamicDesc.classList.remove("hidden");
      } else {
        dynamicDesc.classList.add("hidden");
      }

      // Show appropriate pricing section
      if (propertyType === "bb") {
        const hasRooms = bbRoomsContainer.children.length > 0;
        if (hasRooms && selectedPricing !== "contactHost" && selectedPricing !== "dynamicDates") {
          bbPricingTabs.classList.remove("hidden");
          apartmentPricingContent.classList.add("hidden");
          updateRoomTabs();
          updateRoomPricingContent();
        } else {
          bbPricingTabs.classList.add("hidden");
          apartmentPricingContent.classList.add("hidden");
        }
      } else {
        bbPricingTabs.classList.add("hidden");
        if (selectedPricing !== "contactHost") {
          apartmentPricingContent.classList.remove("hidden");
          updateApartmentPricingContent();
        } else {
          apartmentPricingContent.classList.add("hidden");
        }
      }
    }

    // Listen to pricing type changes
    pricingRadios.forEach(radio => {
      radio.addEventListener("change", updatePricingDisplay);
    });

    // Listen to room additions/deletions
    const observer = new MutationObserver(() => {
      if (propertyType === "bb") {
        updatePricingDisplay();
      }
    });
    observer.observe(bbRoomsContainer, {childList: true});

    // Listen to room name changes to update tabs
    bbRoomsContainer.addEventListener('input', (e) => {
      if (e.target.name?.includes('[name]')) {
        updateRoomTabs();
      }
    });

    // Initial update
    updatePricingDisplay();
  });

  document.addEventListener("DOMContentLoaded", () => {
    const bbSection = document.getElementById("bb-section");
    const apartmentSection = document.getElementById("apartment-section");
    const radios = document.querySelectorAll('input[name="type"]');

    const addRoomBtn = document.getElementById("add-room-btn");
    const bbRoomsContainer = document.getElementById("bb-rooms-container");
    const bbRoomsCounter = document.getElementById("bb-rooms");
    const roomTemplate = document.getElementById("bb-room-template");

    let roomCount = 0;

    // Toggle property type sections
    radios.forEach((radio) => {
      radio.addEventListener("change", () => {
        if (radio.value === "bb" && radio.checked) {
          bbSection.hidden = false;
          apartmentSection.hidden = true;
        } else if (radio.value === "apartment" && radio.checked) {
          bbSection.hidden = true;
          apartmentSection.hidden = false;
        }
      });
    });

    // Update counter
    const updateRoomsCount = () => {
      bbRoomsCounter.textContent = bbRoomsContainer.children.length;
    };

    // Add room
    addRoomBtn.addEventListener("click", () => {
      roomCount++;
      const newRoom = roomTemplate.cloneNode(true);
      newRoom.id = ""; // remove duplicate ID
      newRoom.classList.remove("hidden");
      newRoom.innerHTML = newRoom.innerHTML.replace(/__INDEX__/g, roomCount);

      bbRoomsContainer.appendChild(newRoom);
      updateRoomsCount();

      // Delete button
      const deleteBtn = newRoom.querySelector(".delete-room-btn");
      deleteBtn.addEventListener("click", () => {
        newRoom.remove();
        updateRoomsCount();
      });
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const checkinInput = document.getElementById("checkin");
    const checkoutInput = document.getElementById("checkout");

    if (!checkinInput.value) checkinInput.value = "14:00"; // default 2 PM
    if (!checkoutInput.value) checkoutInput.value = "11:00"; // default 11 AM
  });

  document.addEventListener("DOMContentLoaded", () => {
    const hostRadios = document.querySelectorAll('input[name="hostType"]');
    const companyFields = document.getElementById('companyFields');
    const individualFields = document.getElementById('individualFields');

    const toggleHostFields = () => {
      const selectedType = document.querySelector('input[name="hostType"]:checked')?.value;

      companyFields.classList.toggle('hidden', selectedType !== 'company');
      individualFields.classList.toggle('hidden', selectedType !== 'individual');

      // Clear inputs of hidden section
      const clearInputs = (container) => {
        container.querySelectorAll('input').forEach(input => input.value = '');
      };

      if (selectedType === 'company') clearInputs(individualFields);
      else if (selectedType === 'individual') clearInputs(companyFields);
    };

    // Bind listener to all radios
    hostRadios.forEach(radio => radio.addEventListener('change', toggleHostFields));

    // Optional: Initialize on page load if one is pre-checked
    toggleHostFields();
  });

  //Show directions Tooltip

  const label = document.querySelector('label[for="showDirections"]');
  const tooltip = document.getElementById('tooltip');

  // Show tooltip on mobile tap
  label.addEventListener('click', () => {
    if (window.innerWidth < 768) {
      tooltip.classList.add('opacity-100');
      tooltip.classList.remove('pointer-events-none');

      // hide after 3 seconds
      setTimeout(() => {
        tooltip.classList.remove('opacity-100');
        tooltip.classList.add('pointer-events-none');
      }, 6000);
    }
  });

  // Hover support for desktop
  label.addEventListener('mouseenter', () => {
    if (window.innerWidth >= 768) {
      tooltip.classList.add('opacity-100');
    }
  });

  label.addEventListener('mouseleave', () => {
    if (window.innerWidth >= 768) {
      tooltip.classList.remove('opacity-100');
    }
  });
</script>


<Footer/>
<CookieScript/>
</body>
</html>
