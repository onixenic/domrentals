---
import "../assets/app.css";

const PAGE_TITLE = "Ion Alexandru | Direct Booking Websites for €20/Month";
const PAGE_DESCRIPTION = "Stop paying up to 25% to Airbnb/Booking. Showcase your apartment with a custom, high-speed website for only €20/month.";
const MONTHLY_PRICE = "20€";
const CONTACT_EMAIL = "ion.claudiu1998@gmail.com"
const CONTACT_PHONE = "+39 3452754245"
const CONTACT_WHATSAPP_LINK = "https://wa.me/00393452754245"

const AIRBNB_COLOR = "text-red-400";
const BOOKING_COLOR = "text-blue-600";
---

<!DOCTYPE html>
<html lang="en" data-theme="corporate" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{PAGE_TITLE}</title>
    <meta name="description" content={PAGE_DESCRIPTION} />
</head>
<body class="font-sans leading-relaxed">

<main>

    <!-- 1. HERO SECTION (Primary Focus & Price Anchor) -->
    <section class="hero min-h-[75vh] bg-base-100 pt-16 pb-12">
        <div class="hero-content flex-col max-w-7xl px-4 mx-auto text-center">

            <div class="max-w-4xl">

                <!-- NEW IMPROVED H1: Emphasizing the fee first, then clarifying the platforms -->
                <h1 class="text-3xl md:text-6xl font-extrabold tracking-tight text-base-content mb-4 leading-tight">
                    Do Not Pay Up to <span class="text-red-600">25%</span>
                    <br class="hidden sm:block">
                    to <span class={AIRBNB_COLOR}>Airbnb</span> or <span class={BOOKING_COLOR}>Booking.com</span>.
                </h1>


                <!-- Value Proposition with Price (UPDATED TO text-success) -->
                <p class="text-2xl md:text-3xl font-extrabold mb-5">
                    Showcase Your Property With Us.
                </p>
                <p class="text-2xl md:text-3xl font-extrabold text-success mb-10">
                    Only <span class="text-5xl md:text-6xl font-black">{MONTHLY_PRICE}/month.</span>
                </p>

                <!-- CTA Buttons (Updated to include Showcase button) -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/showcase" class="btn btn-outline btn-primary btn-lg">Property Showcase</a>
                    <button onclick="contact_modal.showModal()" class="btn btn-primary btn-lg shadow-xl">Contact us</button>
                </div>
            </div>

        </div>
    </section>

    ---

    <section class="py-16 md:py-24 bg-base-200" id="about">
        <div class="container mx-auto px-4 max-w-5xl">

            <h2 class="text-3xl md:text-4xl font-extrabold text-center text-base-content mb-12">
                Meet the Engineer. Understand the Service.
            </h2>

            <!-- The Card with Enhanced Layout -->
            <div class="card bg-base-100 shadow-2xl p-0 overflow-hidden">
                <div class="grid lg:grid-cols-12">

                    <!-- LEFT COLUMN: Profile (Visually Distinct) -->
                    <div class="lg:col-span-4 bg-base-300/50 p-8 flex flex-col items-center justify-center text-center">
                        <div class="avatar flex-shrink-0">
                            <div class="w-32 rounded-full ring ring-primary ring-offset-base-300 ring-offset-4 shadow-xl">
                                <img src="/ceo.png" alt="Photo of Ion Claudiu Alexandru, Software Engineer"/>
                            </div>
                        </div>
                        <h3 class="text-3xl font-bold text-base-content mt-6">Ion Claudiu Alexandru</h3>
                        <p class="text-lg font-medium text-primary mt-1">Software Engineer | 27 Yrs Old</p>

                        <div class="divider lg:hidden"></div>
                    </div>

                    <!-- RIGHT COLUMN: Service Details & Benefits -->
                    <div class="lg:col-span-8 p-8 lg:p-10">

                        <!-- UPDATED: Includes photo editing service -->
                        <p class="text-content mb-6 text-lg">
                            I build websites for your apartment or villa. This includes professional photo editing and optimization to ensure your apartment or villa looks stunning and converts visitors into paying guests.
                        </p>

                        <div class="space-y-4">
                            <div class="flex items-start">
                                <span class="text-primary text-2xl mr-3 font-extrabold">✓</span>
                                <p class="text-content">Zero Commission: You pay <span class="text-md font-extrabold">{MONTHLY_PRICE}/month</span> and keep all your booking revenue. Maximize your profit instantly.</p>
                            </div>
                            <div class="flex items-start">
                                <span class="text-primary text-2xl mr-3 font-extrabold">✓</span>
                                <p class="text-content">Built for Conversion: Speed and clear design optimize your site to turn visitors into confirmed guests, not platform lookers.</p>
                            </div>
                            <div class="flex items-start">
                                <span class="text-primary text-2xl mr-3 font-extrabold">✓</span>
                                <p class="text-content">Max <span class="text-md font-extrabold">1-Day</span> Update Guarantee: Contact us anytime to change content (photos, text, pricing), and we guarantee completion within one business day.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Modal (New Element) -->
    <dialog id="contact_modal" class="modal">
        <div class="modal-box p-6 md:p-10 text-center bg-base-100 shadow-2xl rounded-xl">

            <p class="text-lg mb-8 text-base-content opacity-70">I typically respond within one business hour.</p>

            <div class="space-y-4">

                <!-- Email -->
                <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-block btn-outline btn-primary text-lg font-semibold transition duration-200 justify-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
                    {CONTACT_EMAIL}
                </a>

                <!-- WhatsApp -->
                <a href={CONTACT_WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="btn btn-block bg-green-500 hover:bg-green-600 text-white border-none text-lg font-semibold transition duration-200 justify-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
                    {CONTACT_PHONE}`
                </a>

                <!-- Phone -->
                <a href={`tel:${CONTACT_PHONE.replace(/\s/g, '')}`} class="btn btn-block btn-outline btn-neutral text-lg font-semibold transition duration-200 justify-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.408 5.408l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    {CONTACT_PHONE}
                </a>
            </div>

            <div class="modal-action mt-8">
                <form method="dialog">
                    <!-- Close button for the modal -->
                    <button class="btn btn-neutral">Close</button>
                </form>
            </div>
        </div>
        <!-- Add invisible overlay to close when clicking outside -->
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

</main>
</body>
</html>
