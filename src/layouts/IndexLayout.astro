---
import "../assets/app.css";
import Footer from "../components/Footer.astro";
import Cookie from "../components/CookieHeader.astro"
import CookieScript from "../components/CookieScript.astro";
import { SITE_CONFIG } from "../config/constantsConfig";
---


<!DOCTYPE html>
<html lang="en" data-theme="mytheme" class="scroll-smooth" >
<head>
    <Cookie />
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator}/>
    <title>{SITE_CONFIG.PAGE_TITLE}</title>
    <meta name="description" content={SITE_CONFIG.PAGE_DESCRIPTION}/>
</head>
<body class="font-sans leading-relaxed">

<main>

    <slot name="navbar"/>

    <!-- 1. HERO SECTION (Primary Focus & Price Anchor) -->
    <section class="relative min-h-[85vh] overflow-hidden bg-white">

      {/* Background Image Collage */}
        <div class="absolute inset-0 grid grid-cols-3 grid-rows-2 gap-2 px-4">
            <img
                    src="/index/avif/01.avif?height=400&width=400"
                    alt=""
                    class="w-full h-full object-cover rounded-lg"
            />
            <img
                    src="/index/avif/02.avif?height=400&width=400"
                    alt=""
                    class="w-full h-full object-cover rounded-lg"
            />
            <img
                    src="/index/avif/03.avif?height=400&width=400"
                    alt=""
                    class="w-full h-full object-cover rounded-lg"
            />
            <img
                    src="/index/avif/04.avif?height=400&width=400"
                    alt=""
                    class="w-full h-full object-cover rounded-lg"
            />
            <img
                    src="/index/avif/05.avif?height=400&width=400"
                    alt=""
                    class="w-full h-full object-cover rounded-lg"
            />
            <img
                    src="/index/avif/06.avif?height=400&width=400"
                    alt=""
                    class="w-full h-full object-cover rounded-lg"
            />
        </div>

        <div class="absolute inset-0 bg-gradient-to-br from-base-100/30 via-base-100/30 to-base-100/30"></div>

      {/* Content Card */}
        <div class="relative z-10 flex items-center justify-center min-h-[85vh] px-4 py-2">
            <div class="card bg-white max-w-5xl w-full">
                <div class="card-body p-8 md:p-12 text-center">

                    <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-gray-900 mb-4 leading-none">
                        <i class="fas fa-handshake-slash mr-3 text-primary"></i> Maximize Your Rental Revenue
                    </h1>

                    <h2 class="text-xl md:text-3xl font-semibold tracking-tight text-gray-700 mb-6 leading-tight">
                        <i class="fas fa-chart-line mr-3 text-success"></i> Showcase Your Property With Us
                    </h2>


                    <div class="flex flex-wrap justify-center gap-8 mb-2">

                        <div class="flex items-center">
                            <div class="p-3 mr-3 rounded-full bg-green-200 text-green-800 shadow-md">
                                <svg xmlns="http://www.w3.org/2000/svg" id="Layer_1" data-name="Layer 1" viewBox="0 0 24 24" class="w-5 h-5">
                                    <path fill="currentColor" d="M12,0C5.383,0,0,5.383,0,12s5.383,12,12,12,12-5.383,12-12S18.617,0,12,0Zm0,22c-5.514,0-10-4.486-10-10S6.486,2,12,2s10,4.486,10,10-4.486,10-10,10Zm-2-12c0,.378,.271,.698,.644,.76l3.041,.507c1.342,.223,2.315,1.373,2.315,2.733,0,1.654-1.346,3-3,3v2h-2v-2c-1.654,0-3-1.346-3-3h2c0,.552,.448,1,1,1h2c.552,0,1-.448,1-1,0-.378-.271-.698-.644-.76l-3.041-.507c-1.342-.223-2.315-1.373-2.315-2.733,0-1.654,1.346-3,3-3v-2h2v2c1.654,0,3,1.346,3,3h-2c0-.551-.448-1-1-1h-2c-.552,0-1,.449-1,1Z"/>
                                </svg>
                            </div>
                            <div class="px-2 py-2 text-lg font-semibold text-green-800 transition cursor-pointer">
                                Zero Commissions
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="p-3 mr-3 rounded-full bg-indigo-100 text-indigo-700 shadow-md">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5">
                                    <path fill="currentColor" d="M22.5,3.976H19.414a1,1,0,0,0-.707,1.707l1.086,1.086h0l-3.586,3.585a1.024,1.024,0,0,1-1.415,0l-.17-.171a3.071,3.071,0,0,0-4.243,0l-5.1,5.1A1,1,0,1,0,6.7,16.7l5.1-5.1a1.023,1.023,0,0,1,1.415,0l.17.171a3.073,3.073,0,0,0,4.243,0l3.586-3.586h0l1.086,1.086A1,1,0,0,0,24,8.562V5.476A1.5,1.5,0,0,0,22.5,3.976Z"/>
                                    <path fill="currentColor" d="M23,21.976H5a3,3,0,0,1-3-3V1A1,1,0,0,0,0,1V18.976a5.006,5.006,0,0,0,5,5H23a1,1,0,0,0,0-2Z"/>
                                </svg>
                            </div>
                            <div class="px-2 py-2 text-lg font-semibold text-indigo-700 transition cursor-pointer
                            ">
                                High-Converting Design
                            </div>
                        </div>

                        <div class="flex items-center">
                            <div class="p-3 mr-3 rounded-full bg-gray-200 text-gray-800 shadow-md">
                                <svg xmlns="http://www.w3.org/2000/svg" id="Outline" viewBox="0 0 24 24" class="w-5 h-5">
                                    <path fill="currentColor" d="M21,12.424V11A9,9,0,0,0,3,11v1.424A5,5,0,0,0,5,22a2,2,0,0,0,2-2V14a2,2,0,0,0-2-2V11a7,7,0,0,1,14,0v1a2,2,0,0,0-2,2v6a2,2,0,0,0,2,2,5,5,0,0,0,2-9.576ZM5,20H5a3,3,0,0,1,0-6Zm14,0V14a3,3,0,0,1,0,6Z"/>
                                </svg>
                            </div>
                            <div class="px-2 py-2 text-lg font-semibold text-gray-800 transition cursor-pointer">
                                24h Support
                            </div>
                        </div>

                    </div>
                    <p class="text-2xl md:text-3xl font-light mb-6 text-gray-700">
                    </p>


                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a href="/showcase" class="btn btn-outline btn-primary btn-lg">Example</a>
                        <button onclick="contact_modal.showModal()" class="btn btn-primary btn-lg">Contact us</button>
                    </div>

                </div>
            </div>
        </div>
    </section>


    <section class="py-16 md:py-24 bg-white" id="about">
        <div class="container mx-auto px-4 max-w-5xl">

            <h2 class="text-3xl md:text-4xl font-extrabold text-center text-base-content mb-12">
                Meet the Engineer. Understand the Service.
            </h2>

            <!-- The Card with Enhanced Layout -->
            <div class="card bg-white shadow-2xl p-0 overflow-hidden">
                <div class="grid lg:grid-cols-12">

                    <!-- LEFT COLUMN: Profile (Visually Distinct) -->
                    <div class="lg:col-span-4 bg-base-200/50 p-8 flex flex-col items-center justify-center text-center">
                        <div class="avatar flex-shrink-0">
                            <div class="w-32 rounded-full ring ring-primary ring-offset-base-300 ring-offset-4 shadow-xl">
                                <img src="/ceo.png" alt="Photo of Ion Claudiu Alexandru, Software Engineer"/>
                            </div>
                        </div>
                        <h3 class="text-3xl font-bold text-base-content mt-6">Ion Claudiu Alexandru</h3>
                        <p class="text-lg font-medium mt-1">Software Engineer | 27 Yrs Old</p>

                        <div class="divider lg:hidden"></div>
                    </div>

                    <!-- RIGHT COLUMN: Service Details & Benefits -->
                    <div class="lg:col-span-8 p-8 lg:p-10">

                        <!-- UPDATED: Includes photo editing service -->
                        <p class="text-content mb-6 text-lg">
                            I build websites for your apartment or villa. This includes professional photo editing and
                            optimization to ensure your apartment or villa looks stunning and converts visitors into
                            paying guests.
                        </p>

                        <div class="space-y-4">
                            <div class="flex items-start">
                                <span class="text-primary text-2xl mr-3 font-extrabold">✓</span>

                                <!--You pay <span-->
                                <!--    class="text-md font-extrabold">{MONTHLY_PRICE}/month</span> and.-->

                                <p class="text-content">Zero Commission:
                                    Keep all your booking revenue. Maximize your profit instantly.</p>
                            </div>
                            <div class="flex items-start">
                                <span class="text-primary text-2xl mr-3 font-extrabold">✓</span>
                                <p class="text-content">Built for Conversion: Speed and clear design optimize your site
                                    to turn visitors into confirmed guests, not platform lookers.</p>
                            </div>
                            <div class="flex items-start">
                                <span class="text-primary text-2xl mr-3 font-extrabold">✓</span>
                                <p class="text-content">Max <span class="text-md font-extrabold">1-Day</span> Update
                                    Guarantee: Contact us anytime to change content (photos, text, pricing), and we
                                    guarantee completion within one business day.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <Footer/>

    <!-- Contact Modal (New Element) -->
    <dialog id="contact_modal" class="modal">
        <div class="modal-box p-6 md:p-10 text-center bg-base-100 shadow-2xl rounded-xl">

            <p class="text-lg mb-8 text-base-content opacity-70">I typically respond within one business hour.</p>

            <div class="space-y-4">

                <!-- Email -->
                <a href={`mailto:${SITE_CONFIG.CONTACT_EMAIL}`}
                   class="btn btn-block text-lg font-semibold transition-colors duration-300 justify-start hover:bg-base-200 hover:text-base-content">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-mail">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/>
                        <path d="M3 7l9 6l9 -6"/>
                    </svg>
                  {SITE_CONFIG.CONTACT_EMAIL}
                </a>

                <!-- Phone -->
                <a href={`tel:${SITE_CONFIG.CONTACT_PHONE.replace(/\s/g, '')}`}
                   class="btn btn-block text-lg font-semibold transition-colors duration-300 justify-start hover:bg-base-200 hover:text-base-content">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.408 5.408l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  {SITE_CONFIG.CONTACT_PHONE}
                </a>

                <!-- WhatsApp -->
                <a href={SITE_CONFIG.CONTACT_WHATSAPP_LINK} target="_blank" rel="noopener noreferrer"
                   class="btn btn-block bg-primary hover:bg-green-600 text-white border-none text-lg font-semibold transition duration-200 justify-start">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"/>
                        <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"/>
                    </svg>
                    {SITE_CONFIG.CONTACT_PHONE}
                </a>

            </div>

            <div class="modal-action mt-8">
                <form method="dialog">
                    <!-- Close button for the modal -->
                    <button class="btn btn-neutral">Close</button>
                </form>
            </div>
        </div>
        <!-- Add invisible overlay to close when clicking outside -->
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

</main>
<CookieScript />
</body>
</html>
